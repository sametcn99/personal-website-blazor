@page "/{Section}/{Slug}"
@using personal_website_blazor.Models
@inject personal_website_blazor.Interfaces.IContentService ContentService
@inject IJSRuntime Runtime
@inject NavigationManager Navigation
@inject PersistentComponentState ApplicationState
@implements IAsyncDisposable

<PageTitle>@(Post?.Title ?? "Loading...") | Samet Can Cıncık</PageTitle>

@if (Post == null && IsLoading)
{
    @* Show skeleton to prevent layout shift *@
    <ArticleWrapper ShowSkeleton="true">
        <div class="flow-sm" style="margin-top: 1rem;">
            <div class="skeleton" style="width: 100%; height: 40px; margin-bottom: 1rem;"></div>
            <div class="skeleton" style="width: 60%; height: 30px; margin-bottom: 2rem;"></div>
            <div class="skeleton" style="width: 100%; height: 200px; margin-bottom: 1.5rem; border-radius: 12px;"></div>
            <div class="skeleton" style="width: 100%; height: 20px;"></div>
            <div class="skeleton" style="width: 90%; height: 20px;"></div>
            <div class="skeleton" style="width: 95%; height: 20px; margin-bottom: 2.5rem;"></div>
        </div>
    </ArticleWrapper>
}
else if (Post == null)
{
    <div class="page-container page-section">
        <BackToHome />
        <div class="alert alert-error" style="margin-top: 1rem;">Post not found.</div>
    </div>
}
else
{
    <HeadContent>
        <meta name="description" content="@Post.Description" />
        <meta property="og:type" content="article" />
        <meta property="og:title" content="@Post.Title" />
        <meta property="og:description" content="@Post.Description" />
        <meta property="og:locale" content="@GetOpenGraphLocale()" />
        <meta property="og:url" content="@GetCanonicalUrl()" />
        <meta property="og:image" content="@GetOgImageUrl()" />
        <link rel="canonical" href="@GetCanonicalUrl()" />
        @if (Post.PublishDate.HasValue)
        {
            <meta property="article:published_time" content="@GetIsoDate(Post.PublishDate)" />
        }
        @if (Post.UpdatedAt.HasValue)
        {
            <meta property="article:modified_time" content="@GetIsoDate(Post.UpdatedAt)" />
        }
        @foreach (var keyword in GetMetadataKeywords())
        {
            <meta property="article:tag" content="@keyword" />
        }
        <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:title" content="@Post.Title" />
        <meta property="twitter:description" content="@Post.Description" />
        <meta property="twitter:image" content="@GetOgImageUrl()" />
        <StructuredData Data="@ArticleStructuredData" />
    </HeadContent>

    <ArticleWrapper Post="Post" ContentType="@UrlSection" PrevPost="PrevPost" NextPost="NextPost" RandomPost="RandomPost">
        <div class="article-content">
            <HtmlRenderer HtmlContent="@Post.Content" />
        </div>
    </ArticleWrapper>
}

@code {
    [Parameter] public string Section { get; set; } = string.Empty;
    [Parameter] public string Slug { get; set; } = string.Empty;

    private PostModel? Post;
    private PostModel? PrevPost;
    private PostModel? NextPost;
    private PostModel? RandomPost;
    private bool IsLoading = true;
    private string? _initializedSlug;
    private PersistingComponentStateSubscription? _persistSubscription;
    private IJSObjectReference? _contentModule;

    private string UrlSection => Section switch
    {
        "posts" => "blog",
        "projects" => "project",
        "gists" => "gist",
        _ => Section
    };

    private string FsSection => Section switch
    {
        "blog" => "posts",
        "project" => "projects",
        "gist" => "gists",
        _ => Section
    };

    protected override void OnInitialized()
    {
        if (ApplicationState.TryTakeFromJson<PostViewerState>(GetStateKey(), out var state) && state is not null)
        {
            Post = state.Post;
            PrevPost = state.PrevPost;
            NextPost = state.NextPost;
            RandomPost = state.RandomPost;
            IsLoading = false;
        }

        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistStateAsync);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Post is not null && string.Equals(Post.Slug, Slug, StringComparison.OrdinalIgnoreCase) && string.Equals(Post.Section, FsSection, StringComparison.OrdinalIgnoreCase))
        {
            IsLoading = false;
            return;
        }

        IsLoading = true;

        Post = await ContentService.GetPostAsync(FsSection, Slug);

        if (Post != null)
        {
            var allPosts = await ContentService.GetPostsAsync(FsSection);
            var idx = allPosts.FindIndex(p => p.Slug == Slug);
            if (idx >= 0)
            {
                NextPost = idx > 0 ? allPosts[idx - 1] : null;
                PrevPost = idx < allPosts.Count - 1 ? allPosts[idx + 1] : null;
            }

            // Pick a random post excluding current, prev, and next
            var candidates = allPosts.Where(p => p.Slug != Slug && p.Slug != PrevPost?.Slug && p.Slug != NextPost?.Slug).ToList();
            if (candidates.Count > 0)
            {
                RandomPost = candidates[Random.Shared.Next(candidates.Count)];
            }
        }

        IsLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (Post != null && !string.Equals(_initializedSlug, Slug, StringComparison.OrdinalIgnoreCase))
        {
            try
            {
                _contentModule ??= await Runtime.InvokeAsync<IJSObjectReference>("import", "/dist/js/content-scripts.min.js");
                await _contentModule.InvokeVoidAsync("initContent");
                _initializedSlug = Slug;
            }
            catch (Exception ex)
            {
                Console.WriteLine($"JS Error: {ex.Message}");
            }
        }
    }

    private string GetCanonicalUrl()
    {
        if (Post is not null && !string.IsNullOrWhiteSpace(Post.CanonicalUrl))
            return Post.CanonicalUrl;

        return Navigation.ToAbsoluteUri($"/{UrlSection}/{Slug}").ToString();
    }

    private string GetOpenGraphLocale() =>
        string.Equals(Post?.Language, "tr", StringComparison.OrdinalIgnoreCase) ? "tr_TR" : "en_US";

    private static string GetIsoDate(DateTime? value) => value?.ToString("O") ?? string.Empty;

    private IEnumerable<string> GetMetadataKeywords() =>
        (Post?.Tags ?? Array.Empty<string>())
            .Concat(Post?.Technologies ?? Array.Empty<string>())
            .Concat(Post?.Topics ?? Array.Empty<string>())
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase);

    private object? ArticleStructuredData => Post is null
        ? null
        : new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = UrlSection == "project" ? "SoftwareSourceCode" : "BlogPosting",
            ["headline"] = Post.Title,
            ["description"] = Post.Description,
            ["url"] = GetCanonicalUrl(),
            ["mainEntityOfPage"] = GetCanonicalUrl(),
            ["image"] = GetOgImageUrl(),
            ["articleSection"] = Post.ContentType,
            ["datePublished"] = Post.PublishDate?.ToString("O"),
            ["dateModified"] = (Post.UpdatedAt ?? Post.PublishDate)?.ToString("O"),
            ["inLanguage"] = Post.Language,
            ["keywords"] = GetMetadataKeywords().ToArray(),
            ["author"] = new Dictionary<string, object?>
            {
                ["@type"] = "Person",
                ["@id"] = "https://sametcc.me/#samet-can-cincik",
                ["name"] = string.IsNullOrWhiteSpace(Post.Author) ? "Samet Can Cıncık" : Post.Author,
                ["url"] = "https://sametcc.me/about",
            },
        };

    private string GetStateKey() => $"{nameof(PostViewer)}:{FsSection}:{Slug}";

    private Task PersistStateAsync()
    {
        if (Post is null)
        {
            return Task.CompletedTask;
        }

        ApplicationState.PersistAsJson(GetStateKey(), new PostViewerState
        {
            Post = Post,
            PrevPost = PrevPost,
            NextPost = NextPost,
            RandomPost = RandomPost,
        });

        return Task.CompletedTask;
    }

    private string GetOgImageUrl()
    {
        if (!string.IsNullOrWhiteSpace(Post?.Image))
        {
            return Post.Image!.StartsWith("http", StringComparison.OrdinalIgnoreCase)
                ? Post.Image!
                : Navigation.ToAbsoluteUri(Post.Image!).ToString();
        }

        return Navigation.ToAbsoluteUri("/opengraph-image").ToString();
    }

    public async ValueTask DisposeAsync()
    {
        _persistSubscription?.Dispose();
        if (_contentModule is not null)
            await _contentModule.DisposeAsync();
    }

    private sealed class PostViewerState
    {
        public PostModel? Post { get; set; }
        public PostModel? PrevPost { get; set; }
        public PostModel? NextPost { get; set; }
        public PostModel? RandomPost { get; set; }
    }
}
