@page "/rss"
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>RSS Feed | Samet Can Cıncık</PageTitle>

<HeadContent>
    <meta name="description" content="Subscribe to RSS or JSON feeds to follow the latest posts, projects, and gists." />
</HeadContent>

<div class="page-container page-section rss-page">
    <BackToHome />

    <header class="rss-intro">
        <div class="rss-intro-copy">
            <h1 class="text-page-title">@Localizer["Rss_Title"]</h1>
            <p class="text-body text-muted">
                @Localizer["Rss_Intro"]
            </p>
        </div>
        <p class="rss-intro-note text-caption">
            @Localizer["Rss_IntroNote"]
        </p>
    </header>

    <section class="rss-formats" aria-labelledby="rss-formats-title">
        <div class="rss-section-heading">
            <h2 id="rss-formats-title" class="text-section-title">@Localizer["Rss_ChooseFormat"]</h2>
            <span class="text-caption text-muted">@Localizer["Rss_FormatsCount"]</span>
        </div>

        <div class="rss-ledger">
            <article class="rss-format">
                <span class="rss-format-index" aria-hidden="true">01</span>
                <span class="rss-format-icon" aria-hidden="true">
                    <AppIcon Name="rss" />
                </span>
                <div class="rss-format-copy">
                    <p class="rss-format-type">RSS 2.0</p>
                    <h3 class="text-heading">@Localizer["Rss_RssFeedTitle"]</h3>
                    <p class="text-body text-muted">@Localizer["Rss_RssFeedDescription"]</p>
                </div>
                <a class="button button-outline rss-format-action" href="/rss.xml" target="_blank" rel="noopener" data-umami-event="feed-open-rss-xml-click">
                    <span>@Localizer["Rss_OpenRssFeed"]</span>
                    <AppIcon Name="external-link" />
                </a>
            </article>

            <article class="rss-format">
                <span class="rss-format-index" aria-hidden="true">02</span>
                <span class="rss-format-icon rss-format-icon-sage" aria-hidden="true">
                    <AppIcon Name="code" />
                </span>
                <div class="rss-format-copy">
                    <p class="rss-format-type">JSON Feed</p>
                    <h3 class="text-heading">JSON Feed</h3>
                    <p class="text-body text-muted">@Localizer["Rss_JsonFeedDescription"]</p>
                </div>
                <a class="button button-outline rss-format-action" href="/feed.json" target="_blank" rel="noopener" data-umami-event="feed-open-feed-json-click">
                    <span>@Localizer["Rss_OpenJsonFeed"]</span>
                    <AppIcon Name="external-link" />
                </a>
            </article>
        </div>
    </section>

    <section class="rss-guide" aria-labelledby="rss-guide-title">
        <div class="rss-section-heading">
            <h2 id="rss-guide-title" class="text-section-title">@Localizer["Rss_AddToReader"]</h2>
            <span class="text-caption text-muted">@Localizer["Rss_QuickStart"]</span>
        </div>
        <ol class="rss-guide-list">
            <li class="rss-guide-item">
                <span class="rss-guide-index" aria-hidden="true">01</span>
                <p class="text-body text-muted">@Localizer["Rss_GuideStep1"]</p>
            </li>
            <li class="rss-guide-item">
                <span class="rss-guide-index" aria-hidden="true">02</span>
                <p class="text-body text-muted">@Localizer["Rss_GuideStep2"]</p>
            </li>
        </ol>
    </section>
</div>
