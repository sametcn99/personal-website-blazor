@page "/cv/download/{Language}"
@inject IJSRuntime Js
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer
@implements IAsyncDisposable

<PageTitle>Downloading CV... | Samet Can Cıncık</PageTitle>

<HeadContent>
    <meta name="description" content="Preparing your CV download and redirecting back to the CV page." />
</HeadContent>

<div class="page-container center-stack status-page">
    <h1 class="text-section-title">@Localizer["Cv_Preparing"]</h1>
    <div class="spinner spinner-lg"></div>
    <p class="text-body text-muted">@Localizer["Cv_ManualDownloadPrefix"] <a class="link-muted" href="@_fileUrl" download="@_fileName">@Localizer["Cv_ManualDownloadLink"]</a>.</p>
</div>

@code {
    [Parameter] public string Language { get; set; } = string.Empty;

    private string _fileUrl = string.Empty;
    private string _fileName = string.Empty;
    private IJSObjectReference? _domModule;

    protected override void OnInitialized()
    {
        var lang = Language.ToLowerInvariant();
        if (lang == "tr")
        {
            _fileUrl = "/Samet_Can_Cincik_CV_TR.pdf";
            _fileName = "Samet_Can_Cincik_CV_TR.pdf";
        }
        else if (lang == "en")
        {
            _fileUrl = "/Samet_Can_Cincik_CV_EN.pdf";
            _fileName = "Samet_Can_Cincik_CV_EN.pdf";
        }
        else
        {
            Navigation.NavigateTo("/cv");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrEmpty(_fileUrl))
        {
            // Give it a tiny delay to ensure the UI is rendered
            await Task.Delay(500);
            try
            {
                _domModule = await Js.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
                await _domModule.InvokeVoidAsync("downloadFile", _fileUrl, _fileName);
            }
            catch (JSDisconnectedException)
            {
                // Ignore JS disconnection or framework issues
            }
            
            // Optional: Redirect back to CV page after a short delay
            await Task.Delay(2000);
            Navigation.NavigateTo("/cv");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_domModule is not null)
            await _domModule.DisposeAsync();
    }
}
