@inject IJSRuntime JS

<div class="row-end d-print-none">
    <div class="download-menu">
        <button type="button" class="download-trigger" @onclick="ToggleMenu">
            <AppIcon Name="download" />
            <span>Download CV</span>
            <AppIcon Name="chevron-down" />
        </button>

        @if (_isOpen)
        {
            <div class="download-menu-panel">
                <div class="menu-item-row">
                    <span class="menu-item-label">TR</span>
                    <span class="menu-item-actions">
                        <a class="icon-btn" target="_blank" href="/Samet_Can_Cincik_CV_TR.pdf" title="Preview"
                           data-umami-event="cv-preview-tr-click">
                            <AppIcon Name="eye" />
                        </a>
                        <button type="button" class="icon-btn" title="Download" data-umami-event="cv-download-tr-click"
                                @onclick="DownloadTrCv">
                            <AppIcon Name="download" />
                        </button>
                    </span>
                </div>
                <div class="menu-item-row">
                    <span class="menu-item-label">EN</span>
                    <span class="menu-item-actions">
                        <a class="icon-btn" target="_blank" href="/Samet_Can_Cincik_CV_EN.pdf" title="Preview"
                           data-umami-event="cv-preview-en-click">
                            <AppIcon Name="eye" />
                        </a>
                        <button type="button" class="icon-btn" title="Download" data-umami-event="cv-download-en-click"
                                @onclick="DownloadEnCv">
                            <AppIcon Name="download" />
                        </button>
                    </span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool _isOpen;

    private void ToggleMenu() => _isOpen = !_isOpen;

    private async Task DownloadTrCv()
    {
        _isOpen = false;
        await JS.InvokeVoidAsync("downloadFile", "/Samet_Can_Cincik_CV_TR.pdf", "Samet_Can_Cincik_CV_TR.pdf");
    }

    private async Task DownloadEnCv()
    {
        _isOpen = false;
        await JS.InvokeVoidAsync("downloadFile", "/Samet_Can_Cincik_CV_EN.pdf", "Samet_Can_Cincik_CV_EN.pdf");
    }
}