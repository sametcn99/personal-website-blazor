<div class="row-end d-print-none">
    <div class="download-menu">
        <button type="button" class="download-trigger" @onclick="ToggleMenu">
            <AppIcon Name="download" />
            <span>Download CV</span>
            <AppIcon Name="chevron-down" />
        </button>

        @if (_isOpen)
        {
            <div class="download-menu-panel">
                <div class="menu-item-row">
                    <span class="menu-item-label">TR</span>
                    <span class="menu-item-actions">
                        <a class="icon-btn" target="_blank" href="/Samet_Can_Cincik_CV_TR.pdf" title="Preview" data-umami-event="cv-preview-tr-click">
                            <AppIcon Name="eye" />
                        </a>
                        <a class="icon-btn" href="/Samet_Can_Cincik_CV_TR.pdf" download="Samet_Can_Cincik_CV_TR.pdf" title="Download" data-umami-event="cv-download-tr-click">
                            <AppIcon Name="download" />
                        </a>
                    </span>
                </div>
                <div class="menu-item-row">
                    <span class="menu-item-label">EN</span>
                    <span class="menu-item-actions">
                        <a class="icon-btn" target="_blank" href="/Samet_Can_Cincik_CV_EN.pdf" title="Preview" data-umami-event="cv-preview-en-click">
                            <AppIcon Name="eye" />
                        </a>
                        <a class="icon-btn" href="/Samet_Can_Cincik_CV_EN.pdf" download="Samet_Can_Cincik_CV_EN.pdf" title="Download" data-umami-event="cv-download-en-click">
                            <AppIcon Name="download" />
                        </a>
                    </span>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private bool _isOpen;

    private void ToggleMenu() => _isOpen = !_isOpen;
}