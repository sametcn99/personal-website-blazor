@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer
@implements IAsyncDisposable

@if (_isVisible)
{
    <aside class="agent-popup @(_isExiting ? "is-exiting" : null)"
           role="complementary"
           aria-label="@Localizer["AgentPopup_AriaLabel"]">
        <div class="agent-popup-card">
            <div class="agent-popup-header">
                <div class="agent-popup-title-row">
                    <AppIcon Name="bot" Class="agent-popup-icon" />
                    <h3 class="agent-popup-title">@Localizer["AgentPopup_Title"]</h3>
                </div>
                <button type="button"
                        class="agent-popup-close"
                        @onclick="DismissSessionAsync"
                        aria-label="@Localizer["AgentPopup_DismissAriaLabel"]"
                        title="@Localizer["AgentPopup_DismissAriaLabel"]"
                        data-umami-event="agent-popup-dismiss-click">
                    <AppIcon Name="close" />
                </button>
            </div>

            <div class="agent-popup-body">
                <p class="agent-popup-desc">@Localizer["Footer_AgentNote"]</p>
            </div>

            <div class="agent-popup-actions">
                <a href="https://isitagentready.com/sametcc.me"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="agent-popup-action-btn"
                   data-umami-event="agent-popup-report-click">
                    <AppIcon Name="external-link" />
                    <span>@Localizer["AgentPopup_ReportLink"]</span>
                </a>
                <button type="button"
                        class="agent-popup-action-btn copy-btn @(_copied ? "is-copied" : null)"
                        @onclick="CopyPromptAsync"
                        aria-label="@Localizer["AgentPopup_CopyPromptAriaLabel"]"
                        data-umami-event="agent-popup-copy-prompt-click">
                    <AppIcon Name="@(_copied ? "check" : "copy")" />
                    <span>@(_copied ? Localizer["AgentPopup_PromptCopied"] : Localizer["AgentPopup_CopyPrompt"])</span>
                </button>
            </div>
        </div>
    </aside>
}

@code {
    private const string SessionStorageKey = "agent-popup-dismissed-session";
    private bool _isVisible;
    private bool _isExiting;
    private bool _copied;
    private CancellationTokenSource? _cts;
    private IJSObjectReference? _domModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _cts = new CancellationTokenSource();
            try
            {
                var sessionDismissed = await JS.InvokeAsync<string?>("sessionStorage.getItem", _cts.Token, SessionStorageKey);
                if (sessionDismissed == "true")
                {
                    return;
                }

                // Wait 1.2s before displaying to ensure smooth initial page presentation
                await Task.Delay(1200, _cts.Token);
                _isVisible = true;
                StateHasChanged();
            }
            catch (OperationCanceledException)
            {
                // Component disposed before timer elapsed
            }
            catch (Exception)
            {
                // Fallback: don't crash on JS interop or disabled storage
            }
        }
    }

    private async Task DismissSessionAsync()
    {
        if (_isExiting) return;

        _isExiting = true;
        StateHasChanged();

        try
        {
            await Task.Delay(200);
            _isVisible = false;
            _isExiting = false;
            await JS.InvokeVoidAsync("sessionStorage.setItem", SessionStorageKey, "true");
        }
        catch (Exception)
        {
            _isVisible = false;
            _isExiting = false;
        }
    }

    private string BuildAgentPrompt()
    {
        const string publicBase = "https://sametcc.me";
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var targetUrl = string.IsNullOrEmpty(relative) ? publicBase : $"{publicBase}/{relative}";

        return Localizer["AgentPopup_AgentPromptTemplate", targetUrl, publicBase];
    }

    private async Task CopyPromptAsync()
    {
        try
        {
            _domModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
            var prompt = BuildAgentPrompt();
            await _domModule.InvokeVoidAsync("copyToClipboard", prompt);
            _copied = true;
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(2000);
                    _copied = false;
                    await InvokeAsync(StateHasChanged);
                }
                catch
                {
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error copying prompt to clipboard: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            _cts?.Cancel();
            _cts?.Dispose();
        }
        catch
        {
        }

        try
        {
            if (_domModule is not null)
            {
                await _domModule.DisposeAsync();
            }
        }
        catch
        {
        }
    }
}
