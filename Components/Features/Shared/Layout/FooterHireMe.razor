@implements IDisposable
@inject IStringLocalizer<SharedResources> Localizer

<span class="footer-hire-me-wrap">
    <button type="button" class="footer-hire-me" aria-label="@Localizer["Footer_HireMeAriaLabel"]" @onclick="ShowBubbleAsync">
        <span class="footer-hire-me-art">
            <img src="/uploads/media/hire-me.png"
                 width="554"
                 height="476"
                 loading="lazy"
                 decoding="async"
                 fetchpriority="low"
                 alt="" />
        </span>
    </button>
    @foreach (var bubble in _bubbles.Select((id, index) => (id, index)))
    {
        <span @key="bubble.id"
              class="footer-hire-me-bubble"
              style="--bubble-stack-index: @bubble.index;">@Localizer["Footer_HireMeBubble"]</span>
    }
</span>

@code {
    private readonly List<int> _bubbles = [];
    private readonly CancellationTokenSource _disposeCts = new();
    private int _bubbleKey;

    private async Task ShowBubbleAsync()
    {
        var bubbleId = ++_bubbleKey;
        _bubbles.Add(bubbleId);
        await InvokeAsync(StateHasChanged);

        try
        {
            await Task.Delay(2100, _disposeCts.Token);
            _bubbles.Remove(bubbleId);
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException)
        {
        }
    }

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
