@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer

<div class="page-shell @(ShouldHideChrome() ? "redirect-shell" : null)">
    @if (!ShouldHideChrome())
    {
        <SiteHeader />
    }
    <div class="page-content">
        <div class="content-body">@Body</div>

        @if (!ShouldHideChrome())
        {
            <SiteFooter />
        }
    </div>
</div>

@if (!ShouldHideChrome())
{
    <HomeSearchSection />
}

@code {
    private string CurrentPath => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant();

    private bool ShouldHideChrome() =>
        CurrentPath.StartsWith("link/", StringComparison.Ordinal) ||
        CurrentPath.StartsWith("repo/", StringComparison.Ordinal);
}

<div id="blazor-error-ui">
    @Localizer["Error_Unhandled"]
    <a href="" class="reload" data-umami-event="blazor-error-reload-click">@Localizer["Error_Reload"]</a>
    <button type="button" class="dismiss" data-umami-event="blazor-error-dismiss-click"
            aria-label="@Localizer["Error_DismissAriaLabel"]">✕</button>
</div>
