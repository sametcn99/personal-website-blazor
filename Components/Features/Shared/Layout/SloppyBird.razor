@inject IJSRuntime JS
@implements IAsyncDisposable

<section class="sloppy-bird" aria-label="Sloppy Bird game">
    <div @ref="_host" id="@_gameId" class="sloppy-bird-game" aria-live="polite">
        <p class="sloppy-bird-placeholder">Loading Sloppy Bird…</p>
    </div>
</section>

@code {
    private readonly string _gameId = $"sloppy-bird-{Guid.NewGuid():N}";
    private ElementReference _host;
    private IJSObjectReference? _module;
    private IJSObjectReference? _game;
    private bool _isClientInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/sloppy-bird.min.js");
                _game = await _module.InvokeAsync<IJSObjectReference>("mount", _host);
                _isClientInitialized = true;
            }
            catch (JSException)
            {
                // The optional footer game must never terminate the page circuit.
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (!_isClientInitialized)
            return;

        try
        {
            if (_isClientInitialized && _game is not null)
                await _game.InvokeVoidAsync("destroy");
        }
        catch (JSException)
        {
        }
        finally
        {
            if (_game is not null)
                await _game.DisposeAsync();
            if (_module is not null)
                await _module.DisposeAsync();
        }
    }
}
