@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer
@implements IAsyncDisposable

<footer class="site-footer">
    <div class="page-container site-footer-inner">
        <div class="footer-statement">
            <div class="footer-statement-identity">
                <span class="footer-brand">sametcc.me</span>
                <div class="footer-statement-copy">
                    <p>@Localizer["Footer_Tagline"]</p>
                    <p class="footer-archive-note">@Localizer["Footer_ArchiveNote"]</p>
                    <div class="footer-agent-section">
                        <p class="footer-agent-note">@Localizer["Footer_AgentNote"]<br /><a href="https://isitagentready.com/sametcc.me" target="_blank" rel="noopener noreferrer" data-umami-event="footer-agent-ready-click">@Localizer["Footer_AgentReportLink"]</a></p>
                        <div class="footer-agent-actions">
                            <button type="button"
                                    class="footer-agent-copy-btn @(_copied ? "is-copied" : null)"
                                    @onclick="CopyPromptAsync"
                                    aria-label="@Localizer["AgentPopup_CopyPromptAriaLabel"]"
                                    data-umami-event="footer-copy-prompt-click">
                                <AppIcon Name="@(_copied ? "check" : "copy")" />
                                <span>@(_copied ? Localizer["AgentPopup_PromptCopied"] : Localizer["AgentPopup_CopyPrompt"])</span>
                            </button>
                        </div>
                    </div>
                </div>
                <nav class="footer-social-links" aria-label="@Localizer["Footer_SocialLinksAriaLabel"]">
                    <a class="footer-social-link"
                       href="https://github.com/sametcn99"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="@Localizer["Footer_GitHubProfile"]"
                       title="@Localizer["Footer_GitHubProfile"]"
                       data-umami-event="footer-github-click">
                        <AppIcon Name="github" />
                        <span>GitHub</span>
                    </a>
                    <a class="footer-social-link"
                       href="https://linkedin.com/in/sametc0"
                       target="_blank"
                       rel="noopener noreferrer"
                       aria-label="@Localizer["Footer_LinkedInProfile"]"
                       title="@Localizer["Footer_LinkedInProfile"]"
                       data-umami-event="footer-linkedin-click">
                        <AppIcon Name="linkedin" />
                        <span>LinkedIn</span>
                    </a>
                </nav>
            </div>
        </div>
        <nav class="footer-sitemap" aria-label="@Localizer["Footer_NavAriaLabel"]">
            <div class="footer-link-group">
                <p>@Localizer["Footer_Explore"]</p>
                <a href="/">@Localizer["Footer_Home"]</a>
                <a href="/content">@Localizer["Footer_AllContent"]</a>
                <a href="/blog">@Localizer["Footer_Writing"]</a>
                <a href="/gist">@Localizer["Footer_Gists"]</a>
                <a href="/project">@Localizer["Footer_Projects"]</a>
            </div>
            <div class="footer-link-group">
                <p>@Localizer["Footer_ProfileAndWork"]</p>
                <a href="/about">@Localizer["Footer_About"]</a>
                <a href="/timeline">@Localizer["Footer_Timeline"]</a>
                <a href="/skills">@Localizer["Footer_Skills"]</a>
                <a href="/readme">@Localizer["Footer_GitHubReadme"]</a>
                <a href="/cv">@Localizer["Footer_Cv"]</a>
                <a href="/repo">@Localizer["Footer_Repositories"]</a>
                <a href="/link">@Localizer["Footer_Links"]</a>
            </div>
            <div class="footer-link-group">
                <p>@Localizer["Footer_Site"]</p>
                <a href="/rss">@Localizer["Footer_Rss"]</a>
                <a href="/support">@Localizer["Footer_Support"]</a>
                <a href="/privacy-policy">@Localizer["Footer_Privacy"]</a>
            </div>
        </nav>
    </div>
    <SloppyBird />
</footer>

@code {
    private bool _copied;
    private IJSObjectReference? _domModule;

    private string BuildAgentPrompt()
    {
        const string publicBase = "https://sametcc.me";
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/');
        var targetUrl = string.IsNullOrEmpty(relative) ? publicBase : $"{publicBase}/{relative}";

        return Localizer["AgentPopup_AgentPromptTemplate", targetUrl, publicBase];
    }

    private async Task CopyPromptAsync()
    {
        try
        {
            _domModule ??= await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
            var prompt = BuildAgentPrompt();
            await _domModule.InvokeVoidAsync("copyToClipboard", prompt);
            _copied = true;
            StateHasChanged();

            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(2000);
                    _copied = false;
                    await InvokeAsync(StateHasChanged);
                }
                catch
                {
                }
            });
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error copying prompt to clipboard: {ex.Message}");
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_domModule is not null)
            {
                await _domModule.DisposeAsync();
            }
        }
        catch
        {
        }
    }
}
