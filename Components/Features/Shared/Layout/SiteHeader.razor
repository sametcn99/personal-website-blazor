@inject IJSRuntime JS
@implements IAsyncDisposable

<header class="site-header">
    <div class="page-container site-header-inner">
        <NavLink class="site-mark" href="/" Match="NavLinkMatch.All" data-umami-event="header-home-click">
            <span class="site-mark-name">Samet Can Cıncık</span>
        </NavLink>

        <button type="button" class="site-menu-toggle" @onclick="ToggleMenu" aria-expanded="@isMenuOpen" aria-controls="site-navigation">
            <AppIcon Name="@(isMenuOpen ? "close" : "menu")" />
            <span>@(isMenuOpen ? "Close" : "Menu")</span>
        </button>

        <nav id="site-navigation" class="site-nav @(isMenuOpen ? "site-nav-open" : null)" aria-label="Primary navigation">
            <div class="site-nav-panel-header">
                <span>Navigation</span>
                <button type="button" class="site-nav-close" @onclick="CloseMenu" aria-label="Close navigation">
                    <AppIcon Name="close" />
                </button>
            </div>
            <NavLink href="/blog" @onclick="CloseMenu" data-umami-event="header-writing-click">Writing</NavLink>
            <NavLink href="/gist" @onclick="CloseMenu" data-umami-event="header-gists-click">Gists</NavLink>
            <NavLink href="/project" @onclick="CloseMenu" data-umami-event="header-projects-click">Projects</NavLink>
            <NavLink href="/readme" @onclick="CloseMenu" data-umami-event="header-about-click">About</NavLink>
            <button type="button" class="site-search-link" @onclick="OpenSearch" aria-label="Search the archive" data-umami-event="header-search-click">
                <AppIcon Name="search" />
                <span>Search</span>
            </button>
        </nav>

        @if (isMenuOpen)
        {
            <button type="button" class="site-nav-backdrop" @onclick="CloseMenu" aria-label="Close navigation"></button>
        }
    </div>
</header>

@code {
    private bool isMenuOpen;
    private IJSObjectReference? _domModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _domModule = await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ToggleMenu()
    {
        if (isMenuOpen)
        {
            await CloseMenu();
            return;
        }

        isMenuOpen = true;
        if (_domModule is not null)
            await _domModule.InvokeVoidAsync("lockBodyScroll");
    }

    private async Task CloseMenu()
    {
        if (!isMenuOpen)
        {
            return;
        }

        isMenuOpen = false;
        if (_domModule is not null)
            await _domModule.InvokeVoidAsync("unlockBodyScroll");
    }

    private async Task OpenSearch()
    {
        await CloseMenu();
        if (_domModule is not null)
            await _domModule.InvokeVoidAsync("openArchiveSearch");
    }

    public async ValueTask DisposeAsync()
    {
        if (isMenuOpen && _domModule is not null)
            await _domModule.InvokeVoidAsync("unlockBodyScroll");
        if (_domModule is not null)
            await _domModule.DisposeAsync();
    }
}
