@using System.Text.RegularExpressions
@inject IJSRuntime JSRuntime
@implements IAsyncDisposable

<img src="@Src"
     alt="@Alt"
     width="@NormalizedWidthAttribute"
     height="@NormalizedHeightAttribute"
     class="html-content-image"
     style="@GetImageStyle()"
     @onclick="OpenViewer" />

@if (_isViewerOpen)
{
    <div class="image-viewer-backdrop" @onclick="CloseViewer" @onwheel:preventDefault="true" @onwheel:stopPropagation="true">
        <div class="image-viewer-modal" @onclick:stopPropagation="true">
            <div class="image-viewer-toolbar">
                <button type="button" class="icon-button" @onclick="ZoomOut" data-umami-event="image-viewer-zoom-out-click" title="Zoom out">
                    <AppIcon Name="minus" />
                </button>
                <button type="button" class="icon-button" @onclick="ZoomIn" data-umami-event="image-viewer-zoom-in-click" title="Zoom in">
                    <AppIcon Name="plus" />
                </button>
                <button type="button" class="icon-button" @onclick="ResetTransform" data-umami-event="image-viewer-reset-click" title="Reset">
                    <AppIcon Name="target" />
                </button>
                <div class="image-viewer-spacer"></div>
                <button type="button" class="icon-button" @onclick="CloseViewer" data-umami-event="image-viewer-close-click" title="Close">
                    <AppIcon Name="close" />
                </button>
            </div>

            <div class="image-viewer-stage"
                 @onwheel="HandleWheel"
                 @onwheel:preventDefault="true"
                 @onwheel:stopPropagation="true"
                 @onmousedown="StartDrag"
                 @onmousemove="Drag"
                 @onmouseup="EndDrag"
                 @onmouseleave="EndDrag">
                <img src="@Src"
                     alt="@Alt"
                     class="image-viewer-image"
                     draggable="false"
                     style="@GetTransformStyle()" />
            </div>
        </div>
    </div>
}

@code {
    private static readonly Regex SafeDimensionRegex = new(
        @"^\d+(?:\.\d+)?(?:px|rem|em|%)?$",
        RegexOptions.Compiled | RegexOptions.CultureInvariant);

    [Parameter] public string? Src { get; set; }
    [Parameter] public string? Alt { get; set; }
    [Parameter] public string? Width { get; set; }
    [Parameter] public string? Height { get; set; }

    private bool _isViewerOpen;
    private double _zoom = 1.0;
    private double _panX;
    private double _panY;
    private bool _isDragging;
    private double _dragStartX;
    private double _dragStartY;
    private bool _scrollLocked;
    private IJSObjectReference? _domModule;

    private string? NormalizedWidthAttribute => NormalizeHtmlDimension(Width);
    private string? NormalizedHeightAttribute => NormalizeHtmlDimension(Height);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _domModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OpenViewer()
    {
        _isViewerOpen = true;
        ResetTransform();

        await ToggleBodyScrollLock(true);
    }

    private async Task CloseViewer()
    {
        _isViewerOpen = false;
        EndDrag();

        await ToggleBodyScrollLock(false);
    }

    private void ZoomIn()
    {
        _zoom = Math.Min(6, _zoom + 0.2);
    }

    private void ZoomOut()
    {
        _zoom = Math.Max(0.5, _zoom - 0.2);
    }

    private void ResetTransform()
    {
        _zoom = 1.0;
        _panX = 0;
        _panY = 0;
    }

    private void HandleWheel(WheelEventArgs args)
    {
        if (args.DeltaY < 0)
        {
            ZoomIn();
            return;
        }

        ZoomOut();
    }

    private void StartDrag(MouseEventArgs args)
    {
        _isDragging = true;
        _dragStartX = args.ClientX - _panX;
        _dragStartY = args.ClientY - _panY;
    }

    private void Drag(MouseEventArgs args)
    {
        if (!_isDragging)
        {
            return;
        }

        _panX = args.ClientX - _dragStartX;
        _panY = args.ClientY - _dragStartY;
    }

    private void EndDrag()
    {
        _isDragging = false;
    }

    private async Task ToggleBodyScrollLock(bool shouldLock)
    {
        if (shouldLock && !_scrollLocked)
        {
            if (_domModule is null)
                return;

            await _domModule.InvokeVoidAsync("lockBodyScroll");
            _scrollLocked = true;
            return;
        }

        if (!shouldLock && _scrollLocked)
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("unlockBodyScroll");
            _scrollLocked = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_scrollLocked && _domModule is not null)
                await _domModule.InvokeVoidAsync("unlockBodyScroll");
            _scrollLocked = false;
        }
        catch
        {
            _scrollLocked = false;
        }

        if (_domModule is not null)
            await _domModule.DisposeAsync();
    }

    private static string? NormalizeHtmlDimension(string? raw)
    {
        var trimmed = raw?.Trim();
        return string.IsNullOrEmpty(trimmed) || !SafeDimensionRegex.IsMatch(trimmed)
            ? null
            : trimmed;
    }

    private static string? NormalizeCssDimension(string? raw)
    {
        var trimmed = NormalizeHtmlDimension(raw);
        if (trimmed is null)
            return null;

        return char.IsDigit(trimmed[^1]) ? $"{trimmed}px" : trimmed;
    }

    private string GetImageStyle()
    {
        var parts = new List<string> { "cursor: zoom-in" };
        var cssWidth = NormalizeCssDimension(Width);
        var cssHeight = NormalizeCssDimension(Height);

        if (cssWidth is not null)
        {
            parts.Add($"width: min(100%, {cssWidth})");
            if (cssHeight is null)
                parts.Add("height: auto");
        }

        if (cssHeight is not null)
        {
            parts.Add($"height: {cssHeight}");
        }

        return string.Join("; ", parts) + ";";
    }

    private string GetTransformStyle() =>
        $"transform: translate({_panX}px, {_panY}px) scale({_zoom.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)}); cursor: {(_isDragging ? "grabbing" : "grab")};";
}
