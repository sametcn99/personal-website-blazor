@inject IJSRuntime JS
@implements IAsyncDisposable

<div id="@selectId" class="custom-select @(isOpen ? "custom-select-open" : null)" @onkeydown="HandleKeyDown" @attributes="AdditionalAttributes">
    <button type="button"
            class="custom-select-trigger"
            aria-haspopup="listbox"
            aria-expanded="@isOpen"
            @onclick="ToggleOpen">
        <span>@SelectedOption.Label</span>
        <AppIcon Name="chevron-down" />
    </button>

    @if (isOpen)
    {
        <div class="custom-select-menu" role="listbox" tabindex="-1">
            @foreach (var option in Options)
            {
                <button type="button"
                        class="custom-select-option @(option.Value == Value ? "custom-select-option-selected" : null)"
                        role="option"
                        aria-selected="@(option.Value == Value)"
                        @onclick="() => SelectOption(option.Value)">
                    <span>@option.Label</span>
                    @if (option.Value == Value)
                    {
                        <AppIcon Name="check" />
                    }
                </button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Value { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public IReadOnlyList<CustomSelectOption> Options { get; set; } = Array.Empty<CustomSelectOption>();
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes { get; set; }

    private bool isOpen;
    private readonly string selectId = $"custom-select-{Guid.NewGuid():N}";
    private IJSObjectReference? _domModule;
    private DotNetObjectReference<CustomSelect>? _selfRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            var modulePath = $"/{Assets["dist/js/dom.min.js"].TrimStart('/')}";
            _domModule = await JS.InvokeAsync<IJSObjectReference>("import", modulePath);
            _selfRef = DotNetObjectReference.Create(this);
            await _domModule.InvokeVoidAsync("registerCustomSelect", selectId, _selfRef);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException or TaskCanceledException)
        {
        }
    }

    private CustomSelectOption SelectedOption =>
        Options.FirstOrDefault(option => option.Value == Value) ??
        Options.FirstOrDefault() ??
        new CustomSelectOption(string.Empty, "Select");

    private async Task ToggleOpen()
    {
        if (!isOpen)
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("closeOtherCustomSelects", selectId);
        }

        isOpen = !isOpen;
    }

    private async Task SelectOption(string value)
    {
        isOpen = false;
        if (value != Value)
        {
            Value = value;
            await ValueChanged.InvokeAsync(value);
        }
    }

    [JSInvokable]
    public Task CloseAsync()
    {
        if (!isOpen)
            return Task.CompletedTask;

        isOpen = false;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape")
        {
            isOpen = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_domModule is not null)
        {
            try
            {
                await _domModule.InvokeVoidAsync("unregisterCustomSelect", selectId);
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException or TaskCanceledException)
            {
            }

            try
            {
                await _domModule.DisposeAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or JSException or ObjectDisposedException or TaskCanceledException)
            {
            }
        }

        _selfRef?.Dispose();
    }
}
