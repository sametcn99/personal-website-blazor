@* ArticleWrapper.razor - Full article layout with metadata, navigation, and content *@
@using personal_website_blazor.Models
@inject IStringLocalizer<SharedResources> Localizer

<div class="page-container article-shell">
    <BackToHome />

    @if (Post != null)
    {
        <header class="article-record-header">
            <div class="article-record-header-inner">
                <div class="flow-sm">
                    <div class="meta-list text-muted text-caption">
                        @if (Post.PublishDate.HasValue)
                        {
                            <span>
                                @EffectivePublishedLabel: @FormatDate(Post.PublishDate)
                            </span>
                        }
                        @if (HasDistinctUpdatedDate(Post))
                        {
                            <span>
                                @EffectiveUpdatedLabel: @FormatDate(Post.UpdatedAt)
                            </span>
                        }
                        @if (!string.IsNullOrEmpty(Post.Language))
                        {
                            <span>
                                @Post.Language.ToUpperInvariant()
                            </span>
                        }
                    </div>

                    @if (Post.Tags.Length > 0)
                    {
                        <div class="tag-list text-caption text-muted">
                            @foreach (var tag in Post.Tags)
                            {
                                <span>#@tag</span>
                            }
                        </div>
                    }
                    @if (Post.Technologies.Length > 0)
                    {
                        <div class="text-caption text-muted">
                            <strong>@Localizer["Common_Technologies"]:</strong> @string.Join(", ", Post.Technologies)
                        </div>
                    }
                    @if (Post.Topics.Length > 0)
                    {
                        <div class="text-caption text-muted">
                            <strong>@Localizer["Common_Topics"]:</strong> @string.Join(", ", Post.Topics)
                        </div>
                    }
                </div>

                <ArticleShareButton Title="@Post.Title" Description="@Post.Description" />
            </div>
        </header>

        <div class="divider article-divider"></div>

        <TableOfContents Items="Post.TocItems" />

        <article class="article-document">
            @ChildContent
        </article>

        <ArticleNavigation PrevArticle="@PrevArticleRef" NextArticle="@NextArticleRef" RandomArticle="@RandomArticleRef" PrevLabel="@EffectivePrevLabel"
                           NextLabel="@EffectiveNextLabel" />
    }
</div>

@code {
    [Parameter] public PostModel? Post { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public bool ShowSkeleton { get; set; }
    [Parameter] public string ContentType { get; set; } = "blog";
    [Parameter] public string? PublishedLabel { get; set; }
    [Parameter] public string? UpdatedLabel { get; set; }
    [Parameter] public string? PrevLabel { get; set; }
    [Parameter] public string? NextLabel { get; set; }
    [Parameter] public PostModel? PrevPost { get; set; }
    [Parameter] public PostModel? NextPost { get; set; }
    [Parameter] public PostModel? RandomPost { get; set; }

    private string EffectivePublishedLabel => PublishedLabel ?? Localizer["Common_Published"];
    private string EffectiveUpdatedLabel => UpdatedLabel ?? Localizer["Common_Updated"];
    private string EffectivePrevLabel => PrevLabel ?? Localizer["Article_Previous"];
    private string EffectiveNextLabel => NextLabel ?? Localizer["Article_Next"];

    private ArticleNavigation.ArticleRef? PrevArticleRef => PrevPost == null ? null : new()
    {
        Href = $"/{ContentType}/{PrevPost.Slug}",
        Title = PrevPost.Title,
    };

    private ArticleNavigation.ArticleRef? NextArticleRef => NextPost == null ? null : new()
    {
        Href = $"/{ContentType}/{NextPost.Slug}",
        Title = NextPost.Title,
    };

    private ArticleNavigation.ArticleRef? RandomArticleRef => RandomPost == null ? null : new()
    {
        Href = $"/{ContentType}/{RandomPost.Slug}",
        Title = RandomPost.Title,
    };

    private static bool HasDistinctUpdatedDate(PostModel post) =>
        post.UpdatedAt.HasValue && (!post.PublishDate.HasValue || post.UpdatedAt.Value.Date != post.PublishDate.Value.Date);

    private static string FormatDate(DateTime? value) => value?.ToString("ddd MMM dd yyyy") ?? string.Empty;
}
