@using personal_website_blazor.Models
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer
@if (Items is { Length: > 0 })
{
    <nav class="toc-rail" aria-label="@Localizer["Toc_OnThisPage"]">
        @foreach (var item in Items)
        {
            <a class="toc-rail-item toc-rail-level-@item.Level"
               href="@GetHref(item.Id)"
               data-toc-target="@item.Id"
               aria-label="@item.Text">
                <span class="toc-rail-line" aria-hidden="true"></span>
                <span class="toc-rail-label">@item.Text</span>
            </a>
        }
    </nav>

    <details class="toc">
        <summary class="toc-summary">@Localizer["Toc_TableOfContents"]</summary>
        <nav class="toc-nav">
            @foreach (var item in Items)
            {
                var indent = item.Level - 2;
                <a class="toc-link toc-level-@item.Level"
                   href="@GetHref(item.Id)"
                   data-toc-target="@item.Id"
                   style="padding-left: @(0.5 + indent * 0.75)rem;">
                    @item.Text
                </a>
            }
        </nav>
    </details>
}

@code {
    [Parameter] public TocItem[] Items { get; set; } = Array.Empty<TocItem>();

    private string GetHref(string id)
    {
        var current = new Uri(Navigation.Uri);
        return $"{current.AbsolutePath}{current.Query}#{Uri.EscapeDataString(id)}";
    }
}
