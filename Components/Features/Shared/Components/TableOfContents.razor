@using personal_website_blazor.Models
@inject IJSRuntime JsRuntime

@if (Items is { Length: > 0 })
{
    <nav class="toc-rail" aria-label="On this page">
        @foreach (var item in Items)
        {
            <a class="toc-rail-item toc-rail-level-@item.Level"
               href="#@item.Id"
               data-toc-target="@item.Id"
               aria-label="@item.Text">
                <span class="toc-rail-line" aria-hidden="true"></span>
                <span class="toc-rail-label">@item.Text</span>
            </a>
        }
    </nav>

    <details class="toc">
        <summary class="toc-summary">Table of Contents</summary>
        <nav class="toc-nav">
            @foreach (var item in Items)
            {
                var indent = item.Level - 2;
                <a class="toc-link toc-level-@item.Level"
                   href="#@item.Id"
                   style="padding-left: @(0.5 + indent * 0.75)rem;"
                   @onclick="() => ScrollToId(item.Id)"
                   @onclick:preventDefault>
                    @item.Text
                </a>
            }
        </nav>
    </details>
}

@code {
    [Parameter] public TocItem[] Items { get; set; } = Array.Empty<TocItem>();

    private async Task ScrollToId(string id)
    {
        try
        {
            await JsRuntime.InvokeVoidAsync("scrollToElementId", id);
        }
        catch
        {
        }
    }
}
