@* ContentListPage.razor - Reusable content listing with search and sort *@
@inject IStringLocalizer<SharedResources> Localizer

@{
    var visiblePosts = FilteredPosts;
}

<div class="page-container content-list-page">
    <div class="content-index-layout">
        <aside class="content-index-sidebar">
            <BackToHome />

            <header class="content-index-header">
                <h1>@Title</h1>
                <p>@Description</p>
                <div class="content-index-tally" aria-label="@string.Format(Localizer["List_EntriesAriaLabelFormat"], Posts.Count)">
                    <strong>@Posts.Count.ToString("00")</strong>
                    <span>@Localizer["List_RecordsLabel"]</span>
                </div>
            </header>

            <div class="content-list-controls">
                <div class="input-shell">
                    <AppIcon Name="search" />
                    <input class="input-native"
                           @bind="_searchQuery"
                           @bind:event="oninput"
                           @bind:after="OnSearchChanged"
                           placeholder="@string.Format(Localizer["List_SearchPlaceholderFormat"], Title.ToLowerInvariant())"
                           data-umami-event='@UmamiEvent.Click("content-list-search", Title)' />
                </div>
                <div class="content-index-selects">
                    <CustomSelect Value="@_sortBy" ValueChanged="value => _sortBy = value"
                                  Options="@(new[] { new CustomSelectOption("date", Localizer["Sort_Date"]), new CustomSelectOption("title", Localizer["Sort_Title"]) })"
                                  data-umami-event='@UmamiEvent.Click("content-list-sort-by", Title)' />
                    <CustomSelect Value="@_sortOrder" ValueChanged="value => _sortOrder = value"
                                  Options="@(new[] { new CustomSelectOption("desc", _sortBy == "date" ? Localizer["Sort_Newest"] : Localizer["Sort_ZtoA"]), new CustomSelectOption("asc", _sortBy == "date" ? Localizer["Sort_Oldest"] : Localizer["Sort_AtoZ"]) })"
                                  data-umami-event='@UmamiEvent.Click("content-list-sort-order", Title)' />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_searchQuery) && !IsLoading)
            {
                <p class="text-caption text-muted content-list-result-row">
                    @string.Format(Localizer["List_ResultsFoundFormat"], visiblePosts.Count)
                </p>
            }
        </aside>

        <main class="content-index-main">
            @if (IsLoading)
            {
                <div class="content-index-loading">
                    @for (int i = 0; i < 5; i++)
                    {
                        <div class="skeleton"></div>
                    }
                </div>
            }
            else if (visiblePosts.Count == 0)
            {
                <div class="content-index-empty">
                    <p>@(!string.IsNullOrWhiteSpace(_searchQuery) ? string.Format(Localizer["List_NoPostsFoundForFormat"], _searchQuery) : (string)Localizer["List_NoPostsFound"])</p>
                </div>
            }
            else
            {
                <div class="content-index-list">
                @for (var index = 0; index < visiblePosts.Count; index++)
                {
                    var post = visiblePosts[index];
                    <a class="content-list-card-link" href="@($"/{UrlPrefix}/{post.Slug}")"
                       data-umami-event='@UmamiEvent.ClickValue(post.Title, "post")'>
                        <article class="content-list-card">
                            <img class="content-list-card-art"
                                 src="@GetContentAssetUrl(post)"
                                 alt=""
                                 aria-hidden="true"
                                 loading="lazy"
                                 decoding="async" />
                            <div class="content-list-card-main">
                                <div class="content-list-title-row">
                                    <span class="content-list-number">@((index + 1).ToString("00"))</span>
                                    <h2>@post.Title</h2>
                                </div>
                                <p class="content-list-summary">@post.Description</p>
                                @if (GetMetadataLabels(post).Any())
                                {
                                    <div class="content-list-tags" aria-label="@Localizer["List_TagsAriaLabel"]">
                                        @foreach (var tag in GetMetadataLabels(post))
                                        {
                                            <span>#@tag</span>
                                        }
                                    </div>
                                }
                                @if (!string.IsNullOrWhiteSpace(GetMatchSnippet(post)))
                                {
                                    <p class="content-match-snippet">@GetMatchSnippet(post)</p>
                                }
                            </div>
                            <time class="content-list-card-date">@GetDateLabel(post)</time>
                        </article>
                    </a>
                }
                </div>
            }
        </main>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string Description { get; set; } = string.Empty;
    [Parameter] public List<PostModel> Posts { get; set; } = new();
    [Parameter] public string UrlPrefix { get; set; } = "blog";
    [Parameter] public bool IsLoading { get; set; }

    private string _searchQuery = string.Empty;
    private string _sortBy = "date";
    private string _sortOrder = "desc";

    private List<PostModel> FilteredPosts => GetFilteredAndSorted();

    private void OnSearchChanged() => StateHasChanged();

    private List<PostModel> GetFilteredAndSorted()
    {
        var filtered = Posts.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(_searchQuery))
        {
            var q = _searchQuery.ToLowerInvariant();
            filtered = filtered.Where(p =>
                p.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                p.Description.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                GetMetadataLabels(p).Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase)) ||
                p.SearchableText.Contains(q, StringComparison.OrdinalIgnoreCase));
        }

        filtered = _sortBy switch
        {
            "title" => _sortOrder == "asc"
                ? filtered.OrderBy(p => p.Title)
                : filtered.OrderByDescending(p => p.Title),
            _ => _sortOrder == "asc"
                ? filtered.OrderBy(GetSortDate)
                : filtered.OrderByDescending(GetSortDate),
        };

        return filtered.ToList();
    }

    private string GetMatchSnippet(PostModel post)
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
            return string.Empty;

        var q = _searchQuery.Trim();
        var idx = post.SearchableText.IndexOf(q, StringComparison.OrdinalIgnoreCase);
        if (idx < 0)
            return string.Empty;

        var start = Math.Max(0, idx - 40);
        var end = Math.Min(post.SearchableText.Length, idx + q.Length + 40);
        var snippet = post.SearchableText[start..end];

        var prefix = start > 0 ? "..." : "";
        var suffix = end < post.SearchableText.Length ? "..." : "";

        return $"{prefix}{snippet}{suffix}";
    }

    private static DateTime? GetSortDate(PostModel post) => post.UpdatedAt ?? post.PublishDate;

    private static string GetContentAssetUrl(PostModel post) =>
        $"/content/assets/{post.Section}/{post.Slug}.svg";

    private static IEnumerable<string> GetMetadataLabels(PostModel post) =>
        post.Tags
            .Concat(post.Technologies)
            .Concat(post.Topics)
            .Where(value => !string.IsNullOrWhiteSpace(value))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Take(3);

    private static string GetDateLabel(PostModel post)
    {
        var date = post.UpdatedAt ?? post.PublishDate;
        return date?.ToString("yyyy-MM-dd") ?? string.Empty;
    }
}
