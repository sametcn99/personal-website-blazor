@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> Localizer

<div class="article-share">
    <button type="button"
            class="icon-button article-share-button"
            @onclick="ShareAsync"
            data-umami-event="article-share-click"
            title="@Localizer["Article_SharePage"]"
            aria-label="@Localizer["Article_SharePage"]">
        <AppIcon Name="share" />
        <span>@Localizer["Article_Share"]</span>
    </button>

    @if (_linkCopied)
    {
        <div class="article-share-toast" role="status" aria-live="polite">@Localizer["Article_LinkCopied"]</div>
    }
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }

    private bool _linkCopied;
    private CancellationTokenSource? _toastCts;
    private IJSObjectReference? _domModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _domModule = await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ShareAsync()
    {
        try
        {
            if (_domModule is null)
                return;

            var result = await _domModule.InvokeAsync<string>("shareCurrentPage", Title, Description ?? string.Empty);
            if (!string.Equals(result, "copied", StringComparison.Ordinal))
            {
                return;
            }

            _toastCts?.Cancel();
            _toastCts?.Dispose();
            _toastCts = new CancellationTokenSource();
            var token = _toastCts.Token;
            _linkCopied = true;

            await InvokeAsync(StateHasChanged);
            await Task.Delay(2400, token);

            if (!token.IsCancellationRequested)
            {
                _linkCopied = false;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
        catch (JSException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _toastCts?.Cancel();
        _toastCts?.Dispose();
        if (_domModule is not null)
            await _domModule.DisposeAsync();
    }
}
