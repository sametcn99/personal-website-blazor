</svg>

@code {
    [Parameter] public string Name { get; set; } = string.Empty;
    [Parameter] public string? Class { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public bool Decorative { get; set; } = true;
    [Parameter(CaptureUnmatchedValues = true)]
    public IReadOnlyDictionary<string, object>? AdditionalAttributes
    {
        get; set;
    }

    private string? Role => Decorative ? null : "img";
    private string? AriaHidden => Decorative ? "true" : null;

    private string CssClass => string.IsNullOrWhiteSpace(Class) ? "app-icon" : $"app-icon {Class}";
}
