@page "/"
@inject IContentService ContentService
@inject personal_website_blazor.Interfaces.IProfileService ProfileService
@inject PersistentComponentState ApplicationState
@inject IJSRuntime JS
@inject IStringLocalizer<SharedResources> Localizer
@implements IAsyncDisposable

<PageTitle>Samet Can Cıncık — Software Developer Notes &amp; Projects</PageTitle>

<HeadContent>
    <meta property="og:title" content="Samet Can Cıncık — Software Developer Notes &amp; Projects" />
    <meta name="description"
          content="Software engineering essays, practical technical references, and project notes by Samet Can Cincik." />
    <link rel="canonical" href="https://sametcc.me/" />
    <StructuredData Data="@PersonStructuredData" />
</HeadContent>

<div class="page-container home-shell">
    <section class="home-intro" aria-labelledby="home-title">
        <div class="home-intro-copy">
            <h1 id="home-title">@((MarkupString)Localizer["Home_Heading"].Value)</h1>
            <p>
                @Localizer["Home_Intro"]
            </p>
            <div class="home-actions">
                @if (LatestContent is not null)
                {
                    <a class="button button-solid" href="@LatestContent.Href" data-umami-event="home-latest-click">@Localizer["Home_ReadLatest"]</a>
                    }
                    <a class="text-link" href="/content" data-umami-event="home-archive-click">@Localizer["Home_BrowseAll"]</a>
                </div>
            </div>

            <aside class="archive-ledger" aria-label="@Localizer["Home_ArchiveContentsLabel"]">
                <p class="archive-ledger-title">@Localizer["Home_ArchiveContentsLabel"]</p>
                <a href="/content"><span>@Localizer["Home_AllContent"]</span><strong>@(_blogTotal + _gistTotal + _projectTotal)</strong></a>
                <a href="/blog"><span>@Localizer["Home_BlogPosts"]</span><strong>@_blogTotal</strong></a>
                <a href="/gist"><span>@Localizer["Home_TechnicalGists"]</span><strong>@_gistTotal</strong></a>
                <a href="/project"><span>@Localizer["Home_BuiltProjects"]</span><strong>@_projectTotal</strong></a>
                <p class="archive-ledger-status"><span class="status-mark"></span> @Localizer["Home_UpdatedStatus"]</p>
            </aside>
        </section>

        <section id="search" class="home-search-launcher" aria-labelledby="home-search-launcher-title">
            <button type="button" @onclick="OpenSearchAsync" data-umami-event="home-search-open-click">
                <span class="home-search-launcher-copy">
                    <strong id="home-search-launcher-title">@Localizer["Home_SearchLauncherTitle"]</strong>
                    <small>@Localizer["Home_SearchLauncherSubtitle"]</small>
                </span>
                <span class="home-search-launcher-action">
                    <AppIcon Name="search" />
                    @Localizer["Home_OpenSearch"]
                </span>
            </button>
        </section>

        @if (_isLoading)
        {
            <div class="home-loading" aria-label="@Localizer["Home_LoadingRecentAriaLabel"]">
                <div class="skeleton"></div>
                <div class="skeleton"></div>
                <div class="skeleton"></div>
            </div>
        }
        else
        {
            <div class="home-register">
                <section class="register-section" aria-labelledby="recent-writing-title">
                    <div class="register-heading">
                        <h2 id="recent-writing-title">@Localizer["Home_RecentWriting"]</h2>
                        <a href="/blog">@Localizer["Home_WritingIndex"]</a>
                    </div>
                    <div class="register-list writing-folio-list">
                        @foreach (var post in MoreBlogPosts)
                        {
                            <a class="writing-folio-entry" href="@post.Href">
                                <img class="writing-folio-art"
                                     src="@GetContentAssetUrl(post)"
                                     alt=""
                                     aria-hidden="true"
                                     loading="lazy"
                                     decoding="async" />
                                <span class="writing-folio-copy">
                                    <time>@GetShortDate(post)</time>
                                    <strong>@post.Title</strong>
                                    <small>@post.Summary</small>
                                </span>
                            </a>
                        }
                    </div>
                </section>

                <aside class="register-section field-notes" aria-labelledby="field-notes-title">
                    <div class="register-heading">
                        <h2 id="field-notes-title">@Localizer["Home_FieldNotes"]</h2>
                        <a href="/gist">@Localizer["Home_GistIndex"]</a>
                    </div>
                    <div class="field-note-list">
                        @foreach (var gist in _gistPosts.Take(5))
                        {
                            <a class="field-note-card" href="@gist.Href">
                                <img class="field-note-art"
                                     src="@GetContentAssetUrl(gist)"
                                     alt=""
                                     aria-hidden="true"
                                     loading="lazy"
                                     decoding="async" />
                                <span class="field-note-copy">@gist.Title</span>
                                <time>@GetShortDate(gist)</time>
                            </a>
                        }
                    </div>
                </aside>
            </div>

            <section class="project-register" aria-labelledby="project-register-title">
                <div class="register-heading">
                    <div>
                        <h2 id="project-register-title">@Localizer["Home_BuiltWork"]</h2>
                        <p>@Localizer["Home_BuiltWorkSubtitle"]</p>
                    </div>
                    <a href="/project">@Localizer["Home_ProjectIndex"]</a>
                </div>
                <div class="project-register-grid">
                    @foreach (var project in _projectPosts.Take(3))
                    {
                        <a href="@project.Href">
                            <img class="project-register-art"
                                 src="@GetContentAssetUrl(project)"
                                 alt=""
                                 aria-hidden="true"
                                 loading="lazy"
                                 decoding="async" />
                            <span class="project-register-mark"></span>
                            <strong>@project.Title</strong>
                            <p>@project.Summary</p>
                            <small>@GetShortDate(project)</small>
                        </a>
                    }
                </div>
            </section>
        }
    </div>

@code {
    private List<ContentMetadata> _blogPosts = new();
    private List<ContentMetadata> _gistPosts = new();
    private List<ContentMetadata> _projectPosts = new();
    private ProfileDocument? _profile;
    private int _blogTotal;
    private int _gistTotal;
    private int _projectTotal;
    private bool _isLoading = true;
    private PersistingComponentStateSubscription? _persistSubscription;
    private IJSObjectReference? _domModule;

    private ContentMetadata? LatestContent => new[] { _blogPosts.FirstOrDefault(), _gistPosts.FirstOrDefault(),
_projectPosts.FirstOrDefault() }
        .Where(post => post is not null)
        .OrderByDescending(post => GetEffectiveDate(post!))
        .FirstOrDefault();
    private IEnumerable<ContentMetadata> MoreBlogPosts => _blogPosts.Take(5);

    private static string GetContentAssetUrl(ContentMetadata post)
    {
        var parts = post.Href.Trim('/').Split('/', StringSplitOptions.RemoveEmptyEntries);
        var section = parts.FirstOrDefault() switch
        {
            "blog" => "posts",
            "gist" => "gists",
            "project" => "projects",
            _ => "projects",
        };
        var slug = parts.LastOrDefault() ?? string.Empty;
        return $"/content/assets/{section}/{slug}.svg";
    }

    protected override void OnInitialized()
    {
        if (ApplicationState.TryTakeFromJson<HomePageState>(nameof(HomePageState), out var state) && state is not null)
        {
            _blogPosts = state.BlogPosts;
            _gistPosts = state.GistPosts;
            _projectPosts = state.ProjectPosts;
            _blogTotal = state.BlogTotal;
            _gistTotal = state.GistTotal;
            _projectTotal = state.ProjectTotal;
            _isLoading = false;
        }

        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistStateAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();

        if (!_isLoading)
        {
            return;
        }

        var blogs = await ContentService.GetPostsAsync("posts");
        var projects = await ContentService.GetPostsAsync("projects");
        var gists = await ContentService.GetPostsAsync("gists");

        _blogTotal = blogs.Count;
        _projectTotal = projects.Count;
        _gistTotal = gists.Count;

        _blogPosts = blogs.OrderByDescending(GetEffectiveDate).Take(5).Select(ToMeta("blog")).ToList();
        _gistPosts = gists.OrderByDescending(GetEffectiveDate).Take(5).Select(ToMeta("gist")).ToList();
        _projectPosts = projects.OrderByDescending(GetEffectiveDate).Take(5).Select(ToMeta("project")).ToList();
        _isLoading = false;
    }

    private object? PersonStructuredData => _profile is null
        ? null
        : new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "Person",
            ["name"] = _profile.Name,
            ["jobTitle"] = _profile.JobTitle,
            ["description"] = _profile.Summary,
            ["url"] = "https://sametcc.me/",
            ["sameAs"] = _profile.Links.Where(link => link.Type is "github" or "linkedin").Select(link => link.Url),
            ["knowsAbout"] = _profile.Skills.Concat(_profile.AreasOfInterest),
            ["knowsLanguage"] = _profile.Languages,
        };

    private static Func<PostModel, ContentMetadata> ToMeta(string prefix) => p => new ContentMetadata
    {
        Title = p.Title,
        Href = $"/{prefix}/{p.Slug}",
        PublishedAt = p.PublishDate?.ToString("yyyy-MM-dd") ?? "",
        UpdatedAt = p.UpdatedAt?.ToString("yyyy-MM-dd"),
        Summary = p.Description,
        SearchableText = p.SearchableText,
        Tags = p.Tags,
        Language = p.Language,
    };

    private static DateTime? GetEffectiveDate(PostModel post) => post.UpdatedAt ?? post.PublishDate;

    private static string GetShortDate(ContentMetadata post)
    {
        var value = !string.IsNullOrWhiteSpace(post.UpdatedAt) ? post.UpdatedAt : post.PublishedAt;
        return DateTime.TryParse(value, out var date) ? date.ToString("MMM dd, yyyy") : value ?? string.Empty;
    }

    private static DateTime GetEffectiveDate(ContentMetadata post)
    {
        var value = !string.IsNullOrWhiteSpace(post.UpdatedAt) ? post.UpdatedAt : post.PublishedAt;
        return DateTime.TryParse(value, out var date) ? date : DateTime.MinValue;
    }

    private Task PersistStateAsync()
    {
        ApplicationState.PersistAsJson(nameof(HomePageState), new HomePageState
        {
            BlogPosts = _blogPosts,
            GistPosts = _gistPosts,
            ProjectPosts = _projectPosts,
            BlogTotal = _blogTotal,
            GistTotal = _gistTotal,
            ProjectTotal = _projectTotal,
        });

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            _domModule = await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task OpenSearchAsync()
    {
        if (_domModule is not null)
            await _domModule.InvokeVoidAsync("openArchiveSearch");
    }

    public async ValueTask DisposeAsync()
    {
        _persistSubscription?.Dispose();
        if (_domModule is not null)
            await _domModule.DisposeAsync();
    }

    private sealed class HomePageState
    {
        public List<ContentMetadata> BlogPosts { get; set; } = [];
        public List<ContentMetadata> GistPosts { get; set; } = [];
        public List<ContentMetadata> ProjectPosts { get; set; } = [];
        public int BlogTotal { get; set; }
        public int GistTotal { get; set; }
        public int ProjectTotal { get; set; }
    }
}
