@implements IAsyncDisposable
@inject IContentService ContentService
@inject IGitHubService GitHubService
@inject ISocialLinkProvider SocialLinks
@inject IJSRuntime JS
@inject ILogger<HomeSearchSection> Logger
@inject IStringLocalizer<SharedResources> Localizer

<dialog id="archive-search-dialog" class="search-dialog" aria-labelledby="home-search-title">
    <div class="search-dialog-panel">
        <h2 id="home-search-title" class="search-dialog-title">@Localizer["Home_SearchLauncherTitle"]</h2>

        <div class="search-command-input-row">
            <AppIcon Name="search" />
            <input id="home-search-input"
                   class="search-command-input"
                   @bind="_searchQuery"
                   @bind:event="oninput"
                   @bind:after="HandleSearchInputChanged"
                   @onkeydown="HandleInputKeydown"
                   placeholder="@Localizer["Search_Placeholder"]"
                   data-umami-event="home-search-input-click" />
            <span class="search-kbd" aria-hidden="true">ESC</span>
            <button type="button" class="icon-button search-close-button" @onclick="CloseSearchAsync" aria-label="@Localizer["Search_CloseDialogAriaLabel"]">
                <AppIcon Name="close" />
            </button>
        </div>

        <div class="search-command-body">
        @if (_isSearching)
        {
            <div class="search-status">
                <div class="spinner"></div>
                <span class="text-caption text-muted">@Localizer["Search_Searching"]</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(_searchQuery) && !_isSearching)
        {
            @if (_filteredResults.Count > 0)
            {
                <div class="search-result-list" role="listbox" aria-label="@Localizer["Home_SearchLauncherTitle"]">
                    @for (var index = 0; index < _filteredResults.Count; index++)
                    {
                        var item = _filteredResults[index];
                        var isActive = index == _selectedIndex;
                        <a class="search-result-entry @(isActive ? "is-active" : null)"
                           id="search-result-@index"
                           href="@item.Href"
                           target="@(item.External ? "_blank" : null)"
                           rel="@(item.External ? "noreferrer noopener" : null)"
                           role="option"
                           aria-selected="@(isActive ? "true" : "false")"
                           data-umami-event='@UmamiEvent.Click("search-result", item.Title)'>
                            <span class="search-result-main">
                                <span class="search-result-title">@item.Title</span>
                                <span class="search-result-snippet">@(GetRowSnippet(item))</span>
                            </span>
                            <span class="search-result-aside">
                                <span class="search-result-type">@item.TypeLabel@(item.External ? " ↗" : null)</span>
                                <span class="search-result-date">@GetDateOnly(item)</span>
                            </span>
                        </a>
                    }
                </div>
            }
            else
            {
                <p class="search-empty-state text-body text-muted">@Localizer["Search_NoResults"]</p>
            }
        }
        </div>

        <footer class="search-command-footer">
            <span class="search-command-status text-caption text-muted">@GetFooterStatus()</span>
            <span class="search-command-hints" aria-hidden="true">
                <span class="search-kbd">↑</span>
                <span class="search-kbd">↓</span>
                <span class="search-kbd">↵</span>
                <span class="search-kbd">ESC</span>
            </span>
        </footer>
    </div>
</dialog>

@code {
    private const int MaxSearchResults = 10;
    private const int DebounceMs = 250;

    private bool _isSearching;
    private bool _repoFetchStarted;
    private bool _hotkeyRegistered;
    private string _searchQuery = string.Empty;
    private int _selectedIndex;
    private CancellationTokenSource? _debounceCts;
    private readonly List<SearchEntry> _localSearchSource = new();
    private readonly Dictionary<string, SearchEntry> _searchIndexByHref = new(StringComparer.OrdinalIgnoreCase);
    private readonly List<SearchEntry> _cachedRepos = new();
    private List<SearchEntry> _filteredResults = new();
    private DotNetObjectReference<HomeSearchSection>? _dotNetRef;
    private IJSObjectReference? _domModule;
    private IJSObjectReference? _hotkeyModule;
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _hotkeyRegistered)
        {
            return;
        }

        _dotNetRef ??= DotNetObjectReference.Create(this);

        try
        {
            _domModule = await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/dom.min.js");
            _hotkeyModule = await JS.InvokeAsync<IJSObjectReference>("import", "/dist/js/home-search-hotkey.min.js");
            await _hotkeyModule.InvokeVoidAsync("register", _dotNetRef);
            _hotkeyRegistered = true;
        }
        catch (JSDisconnectedException)
        {
        }
    }

    [JSInvokable]
    public async Task HandleGlobalKeyInput(string key, bool ctrlKey, bool metaKey, bool altKey)
    {
        if (ctrlKey || metaKey || altKey)
        {
            return;
        }

        if (key == "Escape")
        {
            await ClearSearchAsync();
            await CloseSearchAsync();
            return;
        }

        if (key == "Backspace")
        {
            if (_searchQuery.Length == 0)
            {
                return;
            }

            _searchQuery = _searchQuery[..^1];
            DebounceSearch();
            await OpenSearchAsync();
            await FocusSearchInputAsync();
            await InvokeAsync(StateHasChanged);
            return;
        }

        if (key.Length == 1)
        {
            _searchQuery += key;

            await OpenSearchAsync();

            if (!_repoFetchStarted && _searchQuery.Length > 0)
            {
                _ = LoadRepositoriesAsync();
            }

            DebounceSearch();
            await FocusSearchInputAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task OnSearchQueryChanged(string? value)
    {
        _searchQuery = value ?? string.Empty;

        if (!_repoFetchStarted && _searchQuery.Length > 0)
        {
            _ = LoadRepositoriesAsync();
        }

        DebounceSearch();
        return Task.CompletedTask;
    }

    private Task HandleSearchInputChanged() => OnSearchQueryChanged(_searchQuery);

    private async Task HandleInputKeydown(KeyboardEventArgs e)
    {
        if (_filteredResults.Count == 0)
        {
            return;
        }

        switch (e.Key)
        {
            case "ArrowDown":
                _selectedIndex = (_selectedIndex + 1) % _filteredResults.Count;
                await InvokeAsync(StateHasChanged);
                await ScrollActiveResultIntoViewAsync();
                break;
            case "ArrowUp":
                _selectedIndex = _selectedIndex <= 0 ? _filteredResults.Count - 1 : _selectedIndex - 1;
                await InvokeAsync(StateHasChanged);
                await ScrollActiveResultIntoViewAsync();
                break;
            case "Enter" when _selectedIndex >= 0 && _selectedIndex < _filteredResults.Count:
                await ActivateSelectedResultAsync();
                break;
        }
    }

    private async Task ScrollActiveResultIntoViewAsync()
    {
        try
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("scrollIntoViewById", $"search-result-{_selectedIndex}");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task ActivateSelectedResultAsync()
    {
        try
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("clickElementById", $"search-result-{_selectedIndex}");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private void DebounceSearch()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();

        var token = _debounceCts.Token;
        _ = DebounceAsync(token);
    }

    private async Task DebounceAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(DebounceMs, token);
            if (!token.IsCancellationRequested)
            {
                await InvokeAsync(PerformSearchAsync);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task PerformSearchAsync()
    {
        if (string.IsNullOrWhiteSpace(_searchQuery))
        {
            _filteredResults.Clear();
            await InvokeAsync(StateHasChanged);
            return;
        }

        _isSearching = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var apiResults = await ContentService.SearchAsync(_searchQuery);

            _searchIndexByHref.Clear();
            _localSearchSource.Clear();
            _filteredResults.Clear();

            if (apiResults is { Count: > 0 })
            {
                foreach (var r in apiResults)
                {
                    AddSearchEntry(new SearchEntry
                    {
                        Title = r.Title,
                        Summary = r.Summary,
                        Href = r.Href,
                        TypeLabel = r.TypeLabel,
                        PublishedAt = r.PublishedAt,
                        UpdatedAt = r.UpdatedAt,
                        MatchSnippet = r.MatchSnippet,
                        Tags = r.Tags,
                    });
                }
            }

            foreach (var link in SocialLinks.Links)
            {
                var q = _searchQuery;
                if (q.Length > 0 && (
                    link.Label.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    link.Category.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    link.Link.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    Array.Exists(link.Type, t => t.Contains(q, StringComparison.OrdinalIgnoreCase))))
                {
                    AddSearchEntry(new SearchEntry
                    {
                        Title = link.Label,
                        Summary = link.Category,
                        Href = link.Link,
                        TypeLabel = "Link",
                        External = link.External,
                    });
                }
            }

            if (_repoFetchStarted)
            {
                ApplyRepoContentFilter();
            }

            _filteredResults = _localSearchSource.Take(MaxSearchResults).ToList();
            _selectedIndex = 0;
        }
        finally
        {
            _isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ClearSearchAsync()
    {
        _searchQuery = string.Empty;
        _filteredResults.Clear();
        _selectedIndex = 0;
        _debounceCts?.Cancel();
        await FocusSearchInputAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task OpenSearchAsync()
    {
        try
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("openArchiveSearch");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task CloseSearchAsync()
    {
        try
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("closeArchiveSearch");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task FocusSearchInputAsync()
    {
        if (!_hotkeyRegistered)
        {
            return;
        }

        try
        {
            if (_domModule is not null)
                await _domModule.InvokeVoidAsync("focusElementById", "home-search-input");
        }
        catch (JSDisconnectedException)
        {
        }
    }

    private async Task LoadRepositoriesAsync()
    {
        if (_repoFetchStarted)
        {
            return;
        }

        _repoFetchStarted = true;

        try
        {
            var repos = await GitHubService.GetUserRepositoriesAsync("sametcn99");

            foreach (var repo in repos)
            {
                if (string.IsNullOrWhiteSpace(repo.HtmlUrl) || string.IsNullOrWhiteSpace(repo.Name))
                {
                    continue;
                }

                var typeLabel = repo.Fork ? "Fork" : "Repository";
                var entry = new SearchEntry
                {
                    Title = repo.Name,
                    Summary = repo.Description ?? string.Empty,
                    Href = repo.HtmlUrl,
                    TypeLabel = typeLabel,
                    PublishedAt = repo.CreatedAt?.ToString("yyyy-MM-dd"),
                    UpdatedAt = repo.UpdatedAt?.ToString("yyyy-MM-dd"),
                    External = true,
                };
                AddSearchEntry(entry);
                _cachedRepos.Add(entry);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load repositories from GitHub");
            _repoFetchStarted = false;
        }
        finally
        {
            if (!string.IsNullOrWhiteSpace(_searchQuery))
            {
                ApplyRepoContentFilter();
                _filteredResults = _localSearchSource.Take(MaxSearchResults).ToList();
                _selectedIndex = 0;
            }

            await InvokeAsync(StateHasChanged);
        }
    }

    private void ApplyRepoContentFilter()
    {
        var q = _searchQuery;

        var matchingRepos = _cachedRepos
            .Where(e =>
                e.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                e.Summary.Contains(q, StringComparison.OrdinalIgnoreCase))
            .ToList();

        _localSearchSource.RemoveAll(e => e.TypeLabel == "Repository" || e.TypeLabel == "Fork");

        foreach (var repo in matchingRepos)
        {
            var href = repo.Href;
            if (!_searchIndexByHref.ContainsKey(href))
            {
                _searchIndexByHref[href] = repo;
                _localSearchSource.Add(repo);
            }
        }
    }

    private void AddSearchEntry(SearchEntry entry)
    {
        if (string.IsNullOrWhiteSpace(entry.Href) || _searchIndexByHref.ContainsKey(entry.Href))
        {
            return;
        }

        _searchIndexByHref[entry.Href] = entry;
        _localSearchSource.Add(entry);
    }

    private static string GetDateOnly(SearchEntry item) =>
        !string.IsNullOrWhiteSpace(item.UpdatedAt) ? item.UpdatedAt
        : !string.IsNullOrWhiteSpace(item.PublishedAt) ? item.PublishedAt
        : string.Empty;

    private static string GetRowSnippet(SearchEntry item) =>
        !string.IsNullOrWhiteSpace(item.MatchSnippet) ? item.MatchSnippet
        : !string.IsNullOrWhiteSpace(item.Summary) ? item.Summary
        : string.Empty;

    private string GetFooterStatus() => _isSearching
        ? Localizer["Search_Searching"]
        : _filteredResults.Count > 0
            ? string.Format(Localizer["Search_ResultCount"], _filteredResults.Count)
            : Localizer["Home_SearchLauncherSubtitle"];

    public async ValueTask DisposeAsync()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();

        if (_hotkeyRegistered)
        {
            try
            {
                if (_hotkeyModule is not null)
                    await _hotkeyModule.InvokeVoidAsync("unregister");
            }
            catch (JSDisconnectedException)
            {
            }
        }

        _dotNetRef?.Dispose();
        if (_hotkeyModule is not null)
            await _hotkeyModule.DisposeAsync();
        if (_domModule is not null)
            await _domModule.DisposeAsync();
    }

    private sealed class SearchEntry
    {
        public string Title { get; set; } = string.Empty;
        public string Summary { get; set; } = string.Empty;
        public string Href { get; set; } = string.Empty;
        public string TypeLabel { get; set; } = string.Empty;
        public string? PublishedAt { get; set; }
        public string? UpdatedAt { get; set; }
        public bool External { get; set; }
        public string MatchSnippet { get; set; } = string.Empty;
        public string[] Tags { get; set; } = Array.Empty<string>();
    }

}
