@page "/link/{Slug}"

@inject ISocialLinkProvider SocialLinks
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@(_social?.Label ?? Localizer["Redirect_Title"]) | Samet Can Cıncık</PageTitle>

<HeadContent>
    <meta name="description" content="@(_social is null ? "Redirecting to selected link." : $"Redirecting to {_social.Label}.")" />
</HeadContent>

@if (_social == null)
{
    <RedirectPage IsNotFound="true"
                  NotFoundMessage="@Localizer["Redirect_LinkNotFound"]"
                  BackHref="/link"
                  BackLabel="@Localizer["Page_Links_Title"]" />
}
else
{
    <RedirectPage TargetUrl="@_social.Link"
                  Label="@_social.Label"
                  BackHref="/link"
                  BackLabel="@Localizer["Page_Links_Title"]" />
}

@code {
    [Parameter] public string Slug { get; set; } = string.Empty;

    private SocialMediaLink? _social;

    protected override void OnParametersSet()
    {
        _social = SocialLinks.Links
            .FirstOrDefault(l => l.Type.Contains(Slug, StringComparer.OrdinalIgnoreCase));
    }
}
