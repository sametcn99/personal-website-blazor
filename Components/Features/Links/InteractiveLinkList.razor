@inject ISocialLinkProvider SocialLinks
@inject IStringLocalizer<SharedResources> Localizer

@{
    var visibleLinks = FilteredLinks.ToList();
}

<div class="page-container content-list-page">
    <div class="content-index-layout">
        <aside class="content-index-sidebar">
            <BackToHome />

            <header class="content-index-header">
                <h1>@Localizer["Page_Links_Title"]</h1>
                <p>@Localizer["Page_Links_Description"]</p>
                <div class="content-index-tally" aria-label="@string.Format(Localizer["List_EntriesAriaLabelFormat"], SocialLinks.Links.Count)">
                    <strong>@SocialLinks.Links.Count.ToString("00")</strong>
                    <span>@Localizer["List_RecordsLabel"]</span>
                </div>
            </header>

            <div class="content-list-controls">
                <div class="input-shell">
                    <AppIcon Name="search" />
                    <input class="input-native"
                           @bind="_search"
                           @bind:event="oninput"
                           placeholder="@Localizer["Links_SearchPlaceholder"]"
                           data-umami-event="links-search-input-click" />
                </div>
                <div class="content-index-selects">
                    <CustomSelect Value="@_selectedCategory" ValueChanged="value => _selectedCategory = value"
                                  Options="@(new[] { new CustomSelectOption("", Localizer["Links_AllCategories"]) }.Concat(_categories.Select(category => new CustomSelectOption(category, category))).ToArray())"
                                  data-umami-event="links-category-select" />
                    <CustomSelect Value="@_sort" ValueChanged="value => _sort = value"
                                  Options="@(new[] { new CustomSelectOption("category", Localizer["Sort_Category"]), new CustomSelectOption("asc", Localizer["Sort_AtoZ"]), new CustomSelectOption("desc", Localizer["Sort_ZtoA"]) })"
                                  data-umami-event="links-sort-select" />
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(_search) || !string.IsNullOrWhiteSpace(_selectedCategory))
            {
                <p class="text-caption text-muted content-list-result-row">
                    @string.Format(Localizer["List_ResultsFoundFormat"], visibleLinks.Count)
                </p>
            }
        </aside>

        <main class="content-index-main">
            @if (visibleLinks.Count == 0)
            {
                <div class="content-index-empty">
                    <p>@(!string.IsNullOrWhiteSpace(_search) ? string.Format(Localizer["Links_NoResultsFoundForFormat"], _search) : (string)Localizer["Links_NoResultsFound"])</p>
                </div>
            }
            else
            {
                <div class="content-index-list">
                    @for (var index = 0; index < visibleLinks.Count; index++)
                    {
                        var link = visibleLinks[index];
                        var slug = link.Type[0];
                        var aliases = link.Type.Length > 1 ? string.Join(", ", link.Type.Skip(1)) : null;
                        <a class="content-list-card-link" href="@($"/link/{slug}")" data-umami-event='@UmamiEvent.Click("links-list", link.Label)'>
                            <article class="content-list-card content-list-card-no-art">
                                <div class="content-list-card-main">
                                    <div class="content-list-title-row content-list-title-row-with-icon">
                                        <span class="content-list-number">@((index + 1).ToString("00"))</span>
                                        <span class="content-list-item-icon" style="color: @(link.IconColor ?? "var(--color-primary-strong)")" aria-hidden="true">
                                            <AppIcon Name="@GetIconName(link)" />
                                        </span>
                                        <h2>@link.Label</h2>
                                    </div>
                                    <p class="content-list-summary">/link/@slug</p>
                                    <div class="content-list-tags" aria-label="@Localizer["Links_DetailsAriaLabel"]">
                                        <span class="content-type-label">@link.Category</span>
                                        @if (link.External)
                                        {
                                            <span>@Localizer["Links_External"]</span>
                                        }
                                        @if (aliases is not null)
                                        {
                                            <span>@string.Format(Localizer["Links_AliasesFormat"], aliases)</span>
                                        }
                                    </div>
                                </div>
                                <div class="content-list-card-date">@link.Category</div>
                            </article>
                        </a>
                    }
                </div>
            }
        </main>
    </div>
</div>

@code {
    private string _search = string.Empty;
    private string? _selectedCategory;
    private string _sort = "category";
    private List<string> _categories = [];

    protected override void OnInitialized()
    {
        _categories = SocialLinks.Links
            .Select(l => l.Category)
            .Distinct()
            .OrderBy(c => SocialLinks.GetCategoryOrder(c))
            .ToList();
    }

    private static string GetIconName(SocialMediaLink link) =>
        link.Type.FirstOrDefault()?.ToLowerInvariant() switch
        {
            "linkedin" => "linkedin",
            "github" => "github",
            "repositories" => "code",
            "vscode-extensions" => "terminal",
            "npm" => "package",
            "leetcode" => "code",
            "telegram" => "send",
            "mail" => "mail",
            "cv" => "file-text",
            "readme" => "file-text",
            "support" => "heart",
            "whatsapp" => "message-circle",
            "youtube" => "play-circle",
            "youtubemusic" => "music",
            "letterboxd" => "film",
            _ => "link",
        };

    private IEnumerable<SocialMediaLink> FilteredLinks
    {
        get
        {
            IEnumerable<SocialMediaLink> links = SocialLinks.Links;

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var q = _search.ToLowerInvariant();
                links = links.Where(l =>
                    l.Label.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || l.Category.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || l.Link.Contains(q, StringComparison.OrdinalIgnoreCase)
                    || l.Type.Any(t => t.Contains(q, StringComparison.OrdinalIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(_selectedCategory))
            {
                links = links.Where(l => l.Category == _selectedCategory);
            }

            links = _sort switch
            {
                "asc" => links.OrderBy(l => l.Label),
                "desc" => links.OrderByDescending(l => l.Label),
                _ => links
                    .OrderBy(l => SocialLinks.GetCategoryOrder(l.Category))
                    .ThenBy(l => l.Label),
            };

            return links.ToList();
        }
    }
}
