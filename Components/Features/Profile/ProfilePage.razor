@page "/about"
@page "/timeline"
@page "/skills"
@using personal_website_blazor.Interfaces
@using personal_website_blazor.Models
@using personal_website_blazor.Utilities
@inject IProfileService ProfileService
@inject IContentService ContentService
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer[PageTitleKey] | Samet Can Cıncık</PageTitle>

<HeadContent>
    <meta name="description" content="@Localizer[DescriptionKey]" />
    <link rel="canonical" href="@CanonicalUrl" />
    <StructuredData Data="@StructuredData" />
</HeadContent>

<div class="page-container page-section">
    <article class="article-content">
        @if (_profile is null)
        {
            <p>Loading profile...</p>
        }
        else if (PageKind == "about")
        {
            <h1>@_profile.Name</h1>
            <p><strong>@_profile.JobTitle</strong> · @_profile.Location</p>
            <p>@_profile.Summary</p>
            <p>@_profile.Biography</p>

            @if (_profile.PublicNotes.Length > 0)
            {
                <h2>@Localizer["Profile_AdditionalNotesHeading"]</h2>
                <ul>
                    @foreach (var note in _profile.PublicNotes)
                    {
                        <li>@note</li>
                    }
                </ul>
            }

            <h2>@Localizer["Profile_SkillsHeading"]</h2>
            @if (_profile.Expertise.Length > 0)
            {
                <div class="skills-expertise">
                    @foreach (var pillar in _profile.Expertise)
                    {
                        <div class="skills-pillar about-pillar">
                            <h3>@pillar.Title</h3>
                            <ul class="skills-competency-list">
                                @foreach (var competency in pillar.Competencies)
                                {
                                    <li class="skills-competency">
                                        <span class="skills-competency-name">@competency.Name</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <p class="skills-index-link-row">
                    <a href="/skills">@Localizer["Home_ExpertiseIndexLink"]</a>
                </p>
            }
            else
            {
                <ul>
                    @foreach (var skill in _profile.Skills)
                    {
                        <li>@skill</li>
                    }
                </ul>
            }

            <h2>@Localizer["Profile_ExperienceHeading"]</h2>
            @foreach (var experience in _profile.Experience)
            {
                <h3>@experience.Role — @experience.Organization</h3>
                <p><strong>@experience.StartDate to @experience.EndDate</strong> · @experience.Location</p>
                <ul>
                    @foreach (var highlight in experience.Highlights)
                    {
                        <li>@highlight</li>
                    }
                </ul>
            }
        }
        else if (PageKind == "timeline")
        {
            <h1>@Localizer["Profile_TimelineHeading"]</h1>
            <p>@string.Format(Localizer["Profile_TimelineIntroFormat"], _profile.Name)</p>

            <h2>@Localizer["Profile_ExperienceHeading"]</h2>
            @foreach (var experience in _profile.Experience)
            {
                <h3>@experience.Role — @experience.Organization</h3>
                <p><strong>@experience.StartDate to @experience.EndDate</strong> · @experience.Location</p>
                <ul>
                    @foreach (var highlight in experience.Highlights)
                    {
                        <li>@highlight</li>
                    }
                </ul>
            }

            <h2>@Localizer["Profile_EducationHeading"]</h2>
            @foreach (var education in _profile.Education)
            {
                <h3>@education.Program — @education.Institution</h3>
                <p><strong>@education.Level</strong> · @education.StartDate to @education.EndDate</p>
                <ul>
                    @foreach (var highlight in education.Highlights)
                    {
                        <li>@highlight</li>
                    }
                </ul>
            }
        }
        else
        {
            <h1>@Localizer["Profile_SkillsHeading"]</h1>
            <p>@Localizer["Profile_SkillsIntro"]</p>

            @if (_profile.Expertise.Length > 0)
            {
                <div class="skills-expertise">
                    @foreach (var pillar in _profile.Expertise)
                    {
                        <section class="skills-pillar">
                            <h2>@pillar.Title</h2>
                            @if (!string.IsNullOrWhiteSpace(pillar.Description))
                            {
                                <p class="skills-pillar-description">@pillar.Description</p>
                            }
                            <ul class="skills-competency-list">
                                @foreach (var competency in pillar.Competencies)
                                {
                                    var resolvedEvidence = competency.Evidence
                                        .Where(_projectLookup.ContainsKey)
                                        .ToList();
                                    <li class="skills-competency">
                                        <span class="skills-competency-name">@competency.Name</span>
                                        @if (resolvedEvidence.Count > 0)
                                        {
                                            <span class="skills-competency-evidence">
                                                <span class="skills-evidence-label">@Localizer["Profile_EvidenceLabel"]</span>
                                                @foreach (var evidenceSlug in resolvedEvidence)
                                                {
                                                    var project = _projectLookup[evidenceSlug];
                                                    var statusLabel = GetStatusLabel(project.ProjectStatus);
                                                    <span class="skills-evidence-item">
                                                        <a href="/project/@evidenceSlug">@project.Title</a>
                                                        @if (statusLabel is not null)
                                                        {
                                                            <span class="skills-evidence-status">@statusLabel</span>
                                                        }
                                                    </span>
                                                }
                                            </span>
                                        }
                                    </li>
                                }
                            </ul>
                        </section>
                    }
                </div>
            }
            else
            {
                <h2>@Localizer["Profile_SkillsHeading"]</h2>
                <ul>
                    @foreach (var skill in _profile.Skills)
                    {
                        <li>@skill</li>
                    }
                </ul>
            }

            <h2>@Localizer["Profile_AreasOfInterestHeading"]</h2>
            <ul>
                @foreach (var area in _profile.AreasOfInterest)
                {
                    <li>@area</li>
                }
            </ul>

            <h2>@Localizer["Profile_LanguagesHeading"]</h2>
            <ul>
                @foreach (var language in _profile.Languages)
                {
                    <li>@language</li>
                }
            </ul>
        }
    </article>
</div>

@code {
    private ProfileDocument? _profile;
    private Dictionary<string, PostModel> _projectLookup = new(StringComparer.OrdinalIgnoreCase);

    private string PageKind => Navigation.ToBaseRelativePath(Navigation.Uri).Trim('/').ToLowerInvariant() switch
    {
        "timeline" => "timeline",
        "skills" => "skills",
        _ => "about",
    };

    private string PageTitleKey => PageKind switch
    {
        "timeline" => "Page_Timeline_Title",
        "skills" => "Page_Skills_Title",
        _ => "Page_About_Title",
    };

    private string DescriptionKey => PageKind switch
    {
        "timeline" => "Page_Timeline_Description",
        "skills" => "Page_Skills_Description",
        _ => "Page_About_Description",
    };

    private string CanonicalUrl => Navigation.ToAbsoluteUri($"/{PageKind}").ToString();

    private LocalizedString? GetStatusLabel(string? projectStatus)
        => ProjectStatusLabels.GetKey(projectStatus) is { } key ? Localizer[key] : null;

    private object? StructuredData => _profile is null
        ? null
        : new Dictionary<string, object?>
        {
            ["@context"] = "https://schema.org",
            ["@type"] = "ProfilePage",
            ["mainEntity"] = new Dictionary<string, object?>
            {
                ["@type"] = "Person",
                ["@id"] = "https://sametcc.me/#samet-can-cincik",
                ["name"] = _profile.Name,
                ["alternateName"] = _profile.AlternateName,
                ["jobTitle"] = _profile.JobTitle,
                ["description"] = _profile.Summary,
                ["url"] = "https://sametcc.me/about",
                ["sameAs"] = _profile.Links.Where(link => link.Type is "github" or "linkedin").Select(link => link.Url),
                ["knowsAbout"] = _profile.Skills.Concat(_profile.AreasOfInterest),
                ["knowsLanguage"] = _profile.Languages,
            },
        };

    protected override async Task OnInitializedAsync()
    {
        _profile = await ProfileService.GetProfileAsync();

        try
        {
            var projects = await ContentService.GetPostMetadataListAsync("projects");
            _projectLookup = projects.ToDictionary(project => project.Slug, StringComparer.OrdinalIgnoreCase);
        }
        catch
        {
            // Evidence links degrade gracefully when the project index is unavailable.
        }
    }
}
