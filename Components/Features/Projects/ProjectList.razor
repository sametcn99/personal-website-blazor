@page "/project"
@inject personal_website_blazor.Interfaces.IContentService ContentService
@inject PersistentComponentState ApplicationState
@inject IStringLocalizer<SharedResources> Localizer
@implements IDisposable

<PageTitle>Projects | Samet Can Cıncık</PageTitle>

<HeadContent>
    <meta name="description" content="Discover my side projects, experiments, and hands-on software builds." />
    <link rel="canonical" href="https://sametcc.me/project" />
</HeadContent>

<ContentListPage Title="@Localizer["Page_Project_Title"]"
                 Description="@Localizer["Page_Project_Description"]"
                 Posts="_posts"
                 UrlPrefix="project"
                 IsLoading="_loading" />

@code {
    private List<PostModel> _posts = new();
    private bool _loading = true;
    private PersistingComponentStateSubscription? _persistSubscription;

    protected override void OnInitialized()
    {
        if (ApplicationState.TryTakeFromJson<List<PostModel>>(nameof(ProjectList), out var posts) && posts is not null)
        {
            _posts = posts;
            _loading = false;
        }

        _persistSubscription = ApplicationState.RegisterOnPersisting(PersistStateAsync);
    }

    protected override async Task OnInitializedAsync()
    {
        if (!_loading)
        {
            return;
        }

        _posts = await ContentService.GetPostMetadataListAsync("projects");
        _loading = false;
    }

    private Task PersistStateAsync()
    {
        ApplicationState.PersistAsJson(nameof(ProjectList), _posts);
        return Task.CompletedTask;
    }

    public void Dispose() => _persistSubscription?.Dispose();
}
