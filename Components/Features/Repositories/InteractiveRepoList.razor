@using personal_website_blazor.Models
@using personal_website_blazor.Utilities
@inject IStringLocalizer<SharedResources> Localizer

@code {
    [Parameter] public List<GitHubRepository> Repos { get; set; } = new();
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public string? Error { get; set; }

    private string _search = string.Empty;
    private string _sortBy = "updated";
    private string _sortOrder = "desc";
    private string? _languageFilter;

    private HashSet<string> AvailableLanguages =>
        Repos.Where(r => !string.IsNullOrEmpty(r.Language))
            .Select(r => r.Language!)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

    private List<GitHubRepository> FilteredRepos
    {
        get
        {
            var query = Repos.AsEnumerable();

            if (!string.IsNullOrWhiteSpace(_search))
            {
                var q = _search.ToLowerInvariant();
                query = query.Where(r =>
                    (r.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Description?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (r.Language?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false));
            }

            if (!string.IsNullOrEmpty(_languageFilter))
            {
                query = query.Where(r =>
                    string.Equals(r.Language, _languageFilter, StringComparison.OrdinalIgnoreCase));
            }

            var sorted = _sortBy switch
            {
                "name" => _sortOrder == "asc"
                    ? query.OrderBy(r => r.Name, StringComparer.OrdinalIgnoreCase)
                    : query.OrderByDescending(r => r.Name, StringComparer.OrdinalIgnoreCase),
                "stars" => _sortOrder == "asc"
                    ? query.OrderBy(r => r.StargazersCount)
                    : query.OrderByDescending(r => r.StargazersCount),
                "created" => _sortOrder == "asc"
                    ? query.OrderBy(r => r.CreatedAt ?? DateTimeOffset.MinValue)
                    : query.OrderByDescending(r => r.CreatedAt ?? DateTimeOffset.MinValue),
                _ => _sortOrder == "asc"
                    ? query.OrderBy(GetActivityDate)
                    : query.OrderByDescending(GetActivityDate),
            };

            return sorted.ToList();
        }
    }

    private static DateTimeOffset GetActivityDate(GitHubRepository repository) =>
        repository.PushedAt ?? repository.UpdatedAt ?? DateTimeOffset.MinValue;

    private static string FormatDate(DateTimeOffset? date)
    {
        if (date is null) return string.Empty;
        return date.Value.UtcDateTime.ToString("yyyy-MM-dd");
    }

    private string FormatUpdatedDate(DateTimeOffset date)
    {
        var now = DateTimeOffset.UtcNow;
        var value = date.ToUniversalTime();

        if (value.Date != now.Date)
        {
            return value.UtcDateTime.ToString("yyyy-MM-dd");
        }

        var elapsed = now - value;
        if (elapsed.TotalMinutes < 1)
        {
            return Localizer["Repo_JustNow"];
        }

        if (elapsed.TotalHours < 1)
        {
            return string.Format(Localizer["Repo_MinutesAgoFormat"], Math.Floor(elapsed.TotalMinutes));
        }

        return string.Format(Localizer["Repo_HoursAgoFormat"], Math.Floor(elapsed.TotalHours));
    }
}

@{
    var visibleRepos = FilteredRepos;
}

<div class="page-container content-list-page">
    <div class="content-index-layout">
        <aside class="content-index-sidebar">
            <BackToHome />

            <header class="content-index-header">
                <h1>@Localizer["Page_Repo_Title"]</h1>
                <p>@Localizer["Page_Repo_Description"]</p>
                <div class="content-index-tally" aria-label="@string.Format(Localizer["List_EntriesAriaLabelFormat"], Repos.Count)">
                    <strong>@Repos.Count.ToString("00")</strong>
                    <span>@Localizer["List_RecordsLabel"]</span>
                </div>
            </header>

            <div class="content-list-controls">
                <div class="input-shell">
                    <AppIcon Name="search" />
                    <input class="input-native"
                           @bind="_search"
                           @bind:event="oninput"
                           placeholder="@Localizer["Repo_SearchPlaceholder"]"
                           data-umami-event="repo-search-input-click" />
                </div>
                <div class="content-index-selects">
                    <CustomSelect Value="@_sortBy" ValueChanged="value => _sortBy = value"
                                  Options="@(new[] { new CustomSelectOption("updated", Localizer["Sort_Updated"]), new CustomSelectOption("created", Localizer["Sort_Created"]), new CustomSelectOption("stars", Localizer["Sort_Stars"]), new CustomSelectOption("name", Localizer["Sort_Name"]) })"
                                  data-umami-event='@UmamiEvent.Click("repo-sort-by", _sortBy)' />
                    <CustomSelect Value="@_sortOrder" ValueChanged="value => _sortOrder = value"
                                  Options="@(new[] { new CustomSelectOption("desc", _sortBy == "name" ? Localizer["Sort_ZtoA"] : Localizer["Sort_Newest"]), new CustomSelectOption("asc", _sortBy == "name" ? Localizer["Sort_AtoZ"] : Localizer["Sort_Oldest"]) })"
                                  data-umami-event='@UmamiEvent.Click("repo-sort-order", _sortOrder)' />
                </div>
                @if (AvailableLanguages.Count > 1)
                {
                    <CustomSelect Value="@_languageFilter" ValueChanged="value => _languageFilter = value"
                                  Options="@(new[] { new CustomSelectOption("", Localizer["Repo_AllLanguages"]) }.Concat(AvailableLanguages.OrderBy(l => l, StringComparer.OrdinalIgnoreCase).Select(lang => new CustomSelectOption(lang, lang))).ToArray())"
                                  data-umami-event='@UmamiEvent.Click("repo-language-filter", _languageFilter)' />
                }
            </div>

            @if ((!string.IsNullOrWhiteSpace(_search) || !string.IsNullOrEmpty(_languageFilter)) && !IsLoading)
            {
                <p class="text-caption text-muted content-list-result-row">
                    @string.Format(Localizer["List_ResultsFoundFormat"], visibleRepos.Count)
                </p>
            }
        </aside>

        <main class="content-index-main">
            @if (IsLoading)
            {
                <div class="content-index-loading">
                    @for (var index = 0; index < 5; index++)
                    {
                        <div class="skeleton"></div>
                    }
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(Error))
            {
                <div class="content-index-empty"><p>@Error</p></div>
            }
            else if (visibleRepos.Count == 0)
            {
                <div class="content-index-empty">
                    <p>@(!string.IsNullOrWhiteSpace(_search) ? string.Format(Localizer["Repo_NoResultsFoundForFormat"], _search) : (string)Localizer["Repo_NoResultsFound"])</p>
                </div>
            }
            else
            {
                <div class="content-index-list">
                    @for (var index = 0; index < visibleRepos.Count; index++)
                    {
                        var repo = visibleRepos[index];
                        <a class="content-list-card-link" href="@($"/repo/{repo.Name}")" data-umami-event='@UmamiEvent.Click("repo-list", repo.Name)'>
                            <article class="content-list-card content-list-card-no-art">
                                <div class="content-list-card-main">
                                    <div class="content-list-title-row">
                                        <span class="content-list-number">@((index + 1).ToString("00"))</span>
                                        <h2>@repo.Name</h2>
                                    </div>
                                    @if (!string.IsNullOrEmpty(repo.Description))
                                    {
                                        <p class="content-list-summary">@repo.Description</p>
                                    }
                                    <div class="content-list-tags" aria-label="@Localizer["Repo_DetailsAriaLabel"]">
                                        @if (!string.IsNullOrEmpty(repo.Language))
                                        {
                                            <span>@repo.Language</span>
                                        }
                                        @if (repo.Fork)
                                        {
                                            <span>@Localizer["Repo_Fork"]</span>
                                        }
                                        @if (repo.StargazersCount > 0)
                                        {
                                            <span>@string.Format(Localizer["Repo_StarsFormat"], repo.StargazersCount)</span>
                                        }
                                    </div>
                                </div>
                                <div class="content-list-card-date">
                                    @if (GetActivityDate(repo) != DateTimeOffset.MinValue)
                                    {
                                        <span>@Localizer["Common_Updated"] @FormatUpdatedDate(GetActivityDate(repo))</span>
                                    }
                                    @if (repo.CreatedAt.HasValue)
                                    {
                                        <span>@Localizer["Repo_CreatedLabel"] @FormatDate(repo.CreatedAt)</span>
                                    }
                                </div>
                            </article>
                        </a>
                    }
                </div>
            }
        </main>
    </div>
</div>
