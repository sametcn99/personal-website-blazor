<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>personal_website_blazor</RootNamespace>
    <UserSecretsId>f44aea12-c646-4712-9b7c-b95947cbb3a3</UserSecretsId>
    <LaunchSettingsFile>Properties\launchSettings.json</LaunchSettingsFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Octokit" Version="14.0.0" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
    <PackageReference Include="Svg.Skia" Version="5.2.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="content/**/*" Exclude="content/profile.json" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="content/profile.json" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="BuildClientAssets"
          BeforeTargets="Build"
          Condition="'$(SkipClientAssetBuild)' != 'true' and '$(DesignTimeBuild)' != 'true'">
    <Exec Command="bun install --frozen-lockfile"
          Condition="!Exists('node_modules/esbuild/bin/esbuild')" />
    <Exec Command="bun run build:assets" />
  </Target>
</Project>
