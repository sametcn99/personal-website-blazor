{
  "private": true,
  "scripts": {
    "build:assets": "bun run build:css && bun run build:js",
    "build:css": "esbuild wwwroot/app.css wwwroot/css/*.css --outdir=wwwroot/dist/css --entry-names=[name].min --minify",
    "build:js": "esbuild wwwroot/js/*.js --outdir=wwwroot/dist/js --entry-names=[name].min --bundle --format=esm --minify",
    "generate:images": "bun run scripts/generate-content-images.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "esbuild": "^0.28.2",
    "gray-matter": "^4.0.3",
    "sharp": "^0.35.3"
  }
}
